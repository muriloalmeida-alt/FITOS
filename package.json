{
  "name": "fitos-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "catalog:import-curated": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-catalogo-curado.ts",
    "catalog:import-imagens-exercicios": "NODE_OPTIONS=--conditions=react-server tsx scripts/import-imagens-exercicios.ts",
    "planos:seed-comerciais": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-planos-comerciais.ts",
    "admin:garantir": "NODE_OPTIONS=--conditions=react-server tsx scripts/garantir-admin.ts",
    "push:chaves": "web-push generate-vapid-keys"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@better-auth/passkey": "^1.7.5",
    "@prisma/client": "6.19.3",
    "better-auth": "1.7.5",
    "csv-parse": "^7.0.2",
    "next": "16.3.5",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "^3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "30.0.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  },
  "prisma": {
    "seed": "NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts"
  }
}
