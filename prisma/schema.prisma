// Modelo físico inicial do FitOS (FIT-007).
// Fonte conceitual: docs/06-engenharia/arquitetura/MODELO-DE-DADOS-CONCEITUAL.md
// Regras de tenancy: docs/06-engenharia/arquitetura/MODELO-MULTITENANT.md
//
// Cada tabela de domínio do personal carrega tenantId explicitamente (nunca
// apenas via join) para que toda consulta possa ser filtrada diretamente por
// tenant, sem confiar em valor vindo do cliente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FIT-013: renomeado de {ATIVO, PAUSADO, ARQUIVADO} (especulação da FIT-007,
/// nunca usada por nenhum código) para {ATIVO, INATIVO} — os dois estados
/// reais definidos pela gestão de alunos (SPRINT-05): não há exclusão física
/// pela interface, apenas inativação, que preserva o histórico.
enum StudentStatus {
  ATIVO
  INATIVO
}

/// FIT-015: apenas as transições reais, disparadas por uma ação (gerar,
/// cancelar, aceitar). "Convite expirado", citado como estado recomendado
/// em docs/00-governanca (junto com PENDENTE/ACEITO/CANCELADO), é tratado
/// como estado **derivado** (`expiresAt < now()` sobre um convite ainda
/// PENDENTE), não persistido — não existe nenhuma tarefa periódica que
/// precise "expirar" convites em lote, e persistir isso duplicaria uma
/// informação já derivável de `expiresAt`.
enum InvitationStatus {
  PENDENTE
  ACEITO
  CANCELADO
}

enum ExerciseOrigin {
  API_NINJAS
  PERSONAL
}

enum WorkoutSessionStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  ABANDONADA
}

enum StudentChargeStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum SaasSubscriptionStatus {
  ATIVA
  INADIMPLENTE
  CANCELADA
}

/// Papel do usuário autenticado (FIT-009). Único critério usado pela camada
/// de autorização (FIT-011) para distinguir personal de aluno — não deve ser
/// confundido com `Tenant.ownerId`/`Student.userId`, que continuam sendo a
/// fonte física de "quem é dono de qual tenant" e "quem é aluno de qual
/// tenant". `role` existe para que o Better Auth e o contexto de sessão
/// saibam o papel antes mesmo de qualquer join com Tenant/Student.
enum UserRole {
  PERSONAL
  ALUNO
}

/// Identidade autenticável. A partir da FIT-009, User também é a tabela de
/// usuário do Better Auth (`docs/06-engenharia/arquitetura/
/// AUTENTICACAO-E-SESSAO.md`): `emailVerified`, `image` e `updatedAt` são
/// campos exigidos pelo schema base do provedor; `role` é um campo adicional
/// nosso (nunca aceito do cliente — sempre definido no servidor).
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          UserRole  @default(PERSONAL)
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownedTenant         Tenant?
  studentProfile      Student?
  authoredAssessments Assessment[] @relation("AssessmentAuthor")
  auditEvents         AuditEvent[]
  sessions            Session[]
  accounts            Account[]

  @@map("users")
}

/// Sessão de autenticação (Better Auth). Não é a fonte de autorização de
/// domínio — o contexto confiável (userId/role/tenantId) é derivado
/// server-side a partir da sessão válida, nunca aceito do cliente (ver
/// FIT-011, `AUTORIZACAO-E-PAPEIS.md`).
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Credencial/provedor de autenticação (Better Auth). Para login por
/// e-mail e senha (único provedor desta História), o hash da senha fica em
/// `password` — nunca texto puro, nunca em log. `accountId` é o
/// identificador do usuário no provedor (aqui, o próprio e-mail
/// normalizado); `providerId` identifica o provedor ("credential").
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Token de verificação (Better Auth) — ex.: confirmação de e-mail, redefinição
/// de senha. Parte do schema base exigido pelo provedor; esta História não
/// envia e-mails reais (fora do escopo — ver AUTENTICACAO-E-SESSAO.md), então
/// a tabela existe mas não é usada ativamente ainda.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

/// Unidade de isolamento multi-tenant: 1 personal trainer = 1 tenant.
/// `ownerId` é único, então cada User é dono de no máximo 1 Tenant.
model Tenant {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  name      String
  createdAt DateTime @default(now())

  owner            User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  students         Student[]
  exercises        Exercise[]
  trainingPlans    TrainingPlan[]
  workouts         Workout[]
  workoutExercises WorkoutExercise[]
  planAssignments  PlanAssignment[]
  workoutSessions  WorkoutSession[]
  assessments      Assessment[]
  studentCharges   StudentCharge[]
  saasSubscription SaasSubscription?
  auditEvents      AuditEvent[]
  invitations      Invitation[]

  @@map("tenants")
}

/// Aluno vinculado a exatamente 1 tenant. `userId` é único quando presente,
/// então cada User (aluno) tem no máximo 1 perfil de Student — multi-personal
/// por aluno exigiria nova decisão e migração planejada (fora do MVP).
///
/// `userId` é opcional (FIT-013): o personal cadastra o aluno (nome + e-mail)
/// antes de existir qualquer conta/sessão — o `User` só passa a existir na
/// ativação do convite (FIT-015). `email` vive no próprio `Student` porque,
/// até a ativação, não há `User` para guardá-lo; é o valor usado tanto para
/// o convite quanto, depois, deve corresponder ao e-mail do `User` vinculado.
/// Único por tenant (`@@unique([tenantId, email])`), não globalmente: dois
/// tenants diferentes podem cadastrar o mesmo e-mail antes de qualquer
/// ativação (a colisão real, se houver, só se manifesta na ativação, onde
/// `User.email` é globalmente único — tratado na FIT-015).
///
/// `@@unique([id, tenantId])` existe para ser referenciado por chave
/// composta a partir de PlanAssignment/WorkoutSession/Assessment/
/// StudentCharge, impedindo que uma dessas tabelas filhas aponte para um
/// Student de um tenant diferente do seu próprio `tenantId`.
model Student {
  id          String        @id @default(cuid())
  tenantId    String
  userId      String?       @unique
  email       String
  displayName String
  status      StudentStatus @default(ATIVO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  planAssignments PlanAssignment[]
  workoutSessions WorkoutSession[]
  assessments     Assessment[]
  charges         StudentCharge[]
  invitations     Invitation[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("students")
}

/// Convite de ativação de conta (FIT-015). Um por tentativa — gerar um novo
/// convite para o mesmo aluno cancela (nunca apaga) qualquer PENDENTE
/// anterior, preservando o histórico. Apenas o hash do token é armazenado
/// (`tokenHash`, SHA-256); o token bruto nunca é persistido, logado nem
/// incluído em evidência — existe apenas na memória do processo entre a
/// geração e a resposta HTTP ao personal.
///
/// `@@unique([studentId, tenantId])` seria incorreto aqui (impediria mais de
/// um convite por aluno ao longo do tempo) — o histórico é modelado como
/// múltiplas linhas com status diferentes, não uma linha só reescrita.
model Invitation {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDENTE)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("invitations")
}

/// Catálogo de exercícios. `tenantId` nulo representa exercício global
/// (importado da API Ninjas e compartilhado); `tenantId` preenchido
/// representa exercício próprio do personal.
///
/// Exercise NÃO participa de FK composta com WorkoutExercise porque
/// `tenantId` pode ser nulo (global) — uma FK composta `[exerciseId, tenantId]`
/// exigiria igualdade exata e rejeitaria todo exercício global. A regra
/// "treino do tenant A não usa exercício privado do tenant B" é imposta por
/// TRIGGER em PostgreSQL (`enforce_workout_exercise_tenant`, ver migration
/// `20260916_add_tenant_composite_constraints`), não representável no
/// Prisma Schema. Documentado em MODELO-FISICO-DE-DADOS.md.
///
/// Um segundo TRIGGER (`enforce_exercise_tenant_immutability`, mesma
/// migration) protege alterações em `Exercise.tenantId`: rejeita transferir
/// um exercício privado para outro tenant, ou torná-lo privado de um tenant,
/// quando isso invalidaria um `WorkoutExercise` já existente de outro
/// tenant. Sem esse trigger, `enforce_workout_exercise_tenant` só valida a
/// criação/alteração do vínculo em `workout_exercises`, não uma alteração
/// posterior no próprio `Exercise`.
/// Campos de catálogo abaixo (`type` a `safetyInfo`, FIT-021) espelham o
/// contrato da Exercises API (ver `src/integrations/api-ninjas/types.ts` e
/// `docs/06-engenharia/arquitetura/adr/ADR-004-API-NINJAS-EXERCICIOS.md`) —
/// todos opcionais, preenchidos para `API_NINJAS` e, quando aplicável,
/// também usados por exercício `PERSONAL` (FIT-022). `externalId` para
/// `API_NINJAS` é uma chave de deduplicação determinística calculada pelo
/// FitOS (hash de nome+tipo+músculo+equipamento+dificuldade normalizados) —
/// a API não retorna um identificador estável; para `PERSONAL` permanece
/// `null` (múltiplas linhas com `externalId` nulo não colidem no índice
/// único, pois o PostgreSQL trata cada `NULL` como distinto).
model Exercise {
  id           String         @id @default(cuid())
  tenantId     String?
  name         String
  origin       ExerciseOrigin
  externalId   String?
  type         String?
  muscle       String?
  equipments   String?
  difficulty   String?
  instructions String?
  safetyInfo   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]

  @@unique([origin, externalId])
  @@index([tenantId])
  @@map("exercises")
}

/// Modelo de treino reutilizável, sempre pertencente a um tenant.
///
/// `@@unique([id, tenantId])` referenciado por chave composta a partir de
/// Workout e PlanAssignment.
model TrainingPlan {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  planAssignments PlanAssignment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("training_plans")
}

/// Treino dentro de um plano. `tenantId` é denormalizado do TrainingPlan
/// para permitir filtro direto por tenant sem depender de join.
///
/// A relação com TrainingPlan usa chave composta `[trainingPlanId, tenantId]`
/// → `TrainingPlan.[id, tenantId]`: o PostgreSQL rejeita fisicamente um
/// Workout cujo `tenantId` seja diferente do `tenantId` do TrainingPlan
/// referenciado (impede treino do tenant A vinculado a plano do tenant B).
///
/// `@@unique([id, tenantId])` referenciado por chave composta a partir de
/// WorkoutExercise e WorkoutSession.
model Workout {
  id             String   @id @default(cuid())
  tenantId       String
  trainingPlanId String
  name           String
  position       Int
  createdAt      DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainingPlan     TrainingPlan      @relation(fields: [trainingPlanId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  workoutSessions  WorkoutSession[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([trainingPlanId, tenantId])
  @@map("workouts")
}

/// Item de um treino, referenciando um exercício do catálogo.
///
/// A relação com Workout usa chave composta `[workoutId, tenantId]` →
/// `Workout.[id, tenantId]`: impede item de treino do tenant A apontar para
/// um Workout do tenant B.
///
/// A relação com Exercise permanece por FK simples (`exerciseId` → `id`)
/// porque Exercise.tenantId pode ser nulo (catálogo global). A regra
/// "exercício privado só pode ser usado por treino do mesmo tenant" é
/// imposta por TRIGGER em PostgreSQL — ver comentário no model Exercise e
/// migration `20260916_add_tenant_composite_constraints`.
model WorkoutExercise {
  id         String   @id @default(cuid())
  tenantId   String
  workoutId  String
  exerciseId String
  position   Int
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workout  Workout  @relation(fields: [workoutId, tenantId], references: [id, tenantId], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([workoutId, tenantId])
  @@map("workout_exercises")
}

/// Versão de plano atribuída a um aluno. Preserva histórico: alterar o
/// TrainingPlan original não altera atribuições já existentes.
///
/// Ambas as relações (Student e TrainingPlan) usam chave composta com
/// `tenantId`: impede atribuir a um aluno de outro tenant, e impede
/// atribuir um plano de outro tenant.
model PlanAssignment {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String
  trainingPlanId String
  active         Boolean  @default(true)
  assignedAt     DateTime @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@index([trainingPlanId, tenantId])
  @@map("plan_assignments")
}

/// Execução de um treino por um aluno.
///
/// Ambas as relações (Student e Workout) usam chave composta com
/// `tenantId`: impede sessão com aluno e treino de tenants diferentes.
model WorkoutSession {
  id         String               @id @default(cuid())
  tenantId   String
  studentId  String
  workoutId  String
  status     WorkoutSessionStatus @default(PLANEJADA)
  occurredAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@index([workoutId, tenantId])
  @@map("workout_sessions")
}

/// Avaliação/evolução manual do aluno. Peso em gramas (Int) para evitar
/// ponto flutuante binário em dado sensível a precisão.
///
/// A relação com Student usa chave composta com `tenantId`: impede
/// avaliação de aluno de outro tenant.
///
/// `authorUserId` permanece FK simples para User — NÃO há constraint física
/// garantindo que o autor pertença ao mesmo tenant do registro. Essa é uma
/// lacuna conhecida (ver "Correção obrigatória 5" / MODELO-FISICO-DE-DADOS.md):
/// User ainda não tem um modelo físico de membership/associação a tenant
/// (personal é dono via Tenant.ownerId, aluno via Student.userId, mas não há
/// uma tabela genérica "este User pertence a este Tenant" que pudesse ser
/// referenciada por chave composta). Implementar essa constraint agora
/// exigiria criar esse modelo de membership — fora do escopo mínimo desta
/// correção — e depende, em última instância, da futura camada de
/// autenticação/autorização.
model Assessment {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  authorUserId String
  weightGrams  Int?
  recordedAt   DateTime @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  authorUser User    @relation("AssessmentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("assessments")
}

/// Controle manual de cobrança do aluno. `amountCents` em centavos (Int)
/// para evitar ponto flutuante binário em valor monetário. Não possui
/// nenhuma FK ou trigger a partir de SaasSubscription — os dois domínios
/// financeiros permanecem estruturalmente separados.
///
/// A relação com Student usa chave composta com `tenantId`: impede cobrança
/// do tenant A vinculada a aluno do tenant B.
model StudentCharge {
  id        String              @id @default(cuid())
  tenantId  String
  studentId String
  status    StudentChargeStatus @default(PENDENTE)
  amountCents Int
  dueDate   DateTime
  createdAt DateTime            @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("student_charges")
}

/// Assinatura SaaS do FitOS contratada pelo personal (tenant). `tenantId`
/// único: no máximo 1 assinatura por tenant. Estruturalmente separada de
/// StudentCharge — nenhuma relação entre os dois modelos.
model SaasSubscription {
  id        String                  @id @default(cuid())
  tenantId  String                  @unique
  status    SaasSubscriptionStatus  @default(ATIVA)
  provider  String
  createdAt DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("saas_subscriptions")
}

/// Evento de auditoria de alteração crítica. Nunca deve registrar senha,
/// token, chave ou conteúdo de credencial (docs/01-produto/REGRAS-DE-NEGOCIO.md).
///
/// `actorUserId` permanece FK simples para User — mesma lacuna conhecida de
/// `Assessment.authorUserId` (ver comentário lá e MODELO-FISICO-DE-DADOS.md):
/// nenhuma constraint física garante que o ator pertença ao tenant do evento.
model AuditEvent {
  id           String   @id @default(cuid())
  tenantId     String
  actorUserId  String
  action       String
  entityType   String
  entityId     String
  occurredAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("audit_events")
}
