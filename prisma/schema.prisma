// Modelo físico inicial do FitOS (FIT-007).
// Fonte conceitual: docs/06-engenharia/arquitetura/MODELO-DE-DADOS-CONCEITUAL.md
// Regras de tenancy: docs/06-engenharia/arquitetura/MODELO-MULTITENANT.md
//
// Cada tabela de domínio do personal carrega tenantId explicitamente (nunca
// apenas via join) para que toda consulta possa ser filtrada diretamente por
// tenant, sem confiar em valor vindo do cliente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// FIT-013: renomeado de {ATIVO, PAUSADO, ARQUIVADO} (especulação da FIT-007,
/// nunca usada por nenhum código) para {ATIVO, INATIVO} — os dois estados
/// reais definidos pela gestão de alunos (SPRINT-05): não há exclusão física
/// pela interface, apenas inativação, que preserva o histórico.
///
/// `VINCULO_ENCERRADO` (FIT-106) é deliberadamente um terceiro estado, não
/// um sinônimo de `INATIVO`: `INATIVO` é uma pausa reversível decidida
/// unilateralmente pelo personal (`reactivateStudent` sempre existe para
/// ela); "encerrar vínculo" é definitivo — nenhuma função deste domínio
/// jamais reabre um vínculo encerrado (ver `ADR-009-ENCERRAMENTO-DE-VINCULO.md`
/// para a decisão completa, incluindo por que o controle de acesso
/// granular do aluno após o encerramento — FIT-107/FIT-108 — não é
/// decidido aqui).
enum StudentStatus {
  ATIVO
  INATIVO
  VINCULO_ENCERRADO
}

/// FIT-015: apenas as transições reais, disparadas por uma ação (gerar,
/// cancelar, aceitar). "Convite expirado", citado como estado recomendado
/// em docs/00-governanca (junto com PENDENTE/ACEITO/CANCELADO), é tratado
/// como estado **derivado** (`expiresAt < now()` sobre um convite ainda
/// PENDENTE), não persistido — não existe nenhuma tarefa periódica que
/// precise "expirar" convites em lote, e persistir isso duplicaria uma
/// informação já derivável de `expiresAt`.
enum InvitationStatus {
  PENDENTE
  ACEITO
  CANCELADO
}

/// `FITOS_CURATED` (IMP-EX-002): segunda fonte de catálogo global, ao lado
/// de `API_NINJAS` — um catálogo estático, autorado diretamente em PT-BR
/// (nunca traduzido de outra língua), carregado de um arquivo versionado no
/// repositório (`src/modules/exercises/data/`), nunca de uma API externa.
/// Qualquer código que trate "catálogo global" como sinônimo de
/// `origin === "API_NINJAS"` está incompleto — a condição correta é sempre
/// "`origin !== "PERSONAL"` e `tenantId` nulo" (ver `visibleCatalogOriginCondition`
/// em `exercises.ts`, corrigida junto com esta migration).
/// Intensidade de um item aeróbico (EPIC-28, ADR-016). INTERVALADO divide
/// o tempo em tiros fortes e recuperações no treino ao vivo.
enum CardioIntensity {
  LEVE
  MODERADO
  FORTE
  INTERVALADO
}

enum ExerciseOrigin {
  API_NINJAS
  PERSONAL
  FITOS_CURATED
}

/// Ciclo de vida do exercício próprio (FIT-022). Exercício global
/// (`origin: API_NINJAS`) sempre `ATIVO` — este módulo não arquiva
/// exercício global, apenas próprio.
enum ExerciseStatus {
  ATIVO
  ARQUIVADO
}

enum WorkoutSessionStatus {
  PLANEJADA
  EM_ANDAMENTO
  CONCLUIDA
  ABANDONADA
}

/// Ciclo de vida do modelo de treino (FIT-030). Mesmo padrão de
/// `ExerciseStatus` — arquivar nunca é exclusão física.
/// `AVULSO` (treino avulso do FitOS Livre): montado durante a execução,
/// fora das listas de treinos; "Salvar nos meus treinos" o torna ATIVO.
enum WorkoutStatus {
  ATIVO
  ARQUIVADO
  AVULSO
}

/// Ciclo de vida do plano semanal (FIT-030/FIT-032). Um `TrainingPlan` com
/// `isSnapshot: true` (ver ADR-005) nunca muda de status por esta via — é
/// uma cópia imutável criada pela atribuição (FIT-033), não um plano
/// editável pelo personal.
enum TrainingPlanStatus {
  ATIVO
  ARQUIVADO
}

enum StudentChargeStatus {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum SaasSubscriptionStatus {
  ATIVA
  INADIMPLENTE
  CANCELADA
}

enum BillingCycle {
  MENSAL
  ANUAL
}

/// Papel do usuário autenticado (FIT-009). Único critério usado pela camada
/// de autorização (FIT-011) para distinguir personal de aluno — não deve ser
/// confundido com `Tenant.ownerId`/`Student.userId`, que continuam sendo a
/// fonte física de "quem é dono de qual tenant" e "quem é aluno de qual
/// tenant". `role` existe para que o Better Auth e o contexto de sessão
/// saibam o papel antes mesmo de qualquer join com Tenant/Student.
enum UserRole {
  PERSONAL
  ALUNO
  /// FIT-100 (EPIC-13): dono de um workspace `INDIVIDUAL` (FitOS Livre) —
  /// treina sozinho, sem personal. Nunca `ALUNO`, mesmo depois de encerrar
  /// um vínculo com um personal (FIT-106) — são papéis diferentes, ver
  /// `05_TRANSICAO_PERSONAL_PARA_LIVRE.md` do pacote pós-MVP.
  INDIVIDUAL
  /// Administrador da plataforma: gerencia todos os usuários (senha e
  /// exclusão). Sem tenant. Nunca vem do cadastro público; só do script
  /// `admin:garantir` (ADMIN_EMAIL/ADMIN_PASSWORD no ambiente).
  ADMIN
}

/// Identidade autenticável. A partir da FIT-009, User também é a tabela de
/// usuário do Better Auth (`docs/06-engenharia/arquitetura/
/// AUTENTICACAO-E-SESSAO.md`): `emailVerified`, `image` e `updatedAt` são
/// campos exigidos pelo schema base do provedor; `role` é um campo adicional
/// nosso (nunca aceito do cliente — sempre definido no servidor).
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          UserRole @default(PERSONAL)
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownedTenant          Tenant?
  studentProfile       Student?
  endedStudentBonds    Student[]             @relation("StudentBondEndedBy")
  authoredAssessments  Assessment[]          @relation("AssessmentAuthor")
  recordedPayments     Payment[]
  auditEvents          AuditEvent[]
  sessions             Session[]
  accounts             Account[]
  pushSubscriptions    PushSubscription[]
  notificationSettings NotificationSettings?
  passkeys             Passkey[]
  avatar               UserAvatar?
  personalAlerts       PersonalAlert[]
  chatMessages         ChatMessage[]
  uploadedPhotos       EvolutionPhoto[]      @relation("EvolutionPhotoUploader")
  healthFormsFilled    HealthForm[]          @relation("HealthFormFiller")
  musicPreference      MusicPreference?
  friendGroupsOwned    FriendGroup[]         @relation("FriendGroupOwner")
  friendGroupMembers   FriendGroupMember[]
  contestsOpened       ScoreContest[]        @relation("ContestOpenedBy")
  contestsToReview     ScoreContest[]        @relation("ContestReviewer")

  @@map("users")
}

/// Aparelho que aceitou receber notificações (EPIC-31, Web Push). Um
/// usuário pode ter vários (celular, computador). `endpoint` identifica o
/// aparelho no serviço de push; inscrição que o serviço recusa (404/410) é
/// apagada no envio.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Aviso de vencimento da assinatura FitOS já enviado (EPIC-34): um por
/// tenant, data de vencimento e tipo ("5_DIAS" ou "NO_DIA"). A unicidade
/// garante um aviso só, mesmo com mais de uma instância rodando.
model SubscriptionDueReminder {
  id       String   @id @default(cuid())
  tenantId String
  dueOn    String
  kind     String
  sentAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dueOn, kind])
  @@map("subscription_due_reminders")
}

/// Preferências de notificação (EPIC-31). `reminderHour` (0-23, horário de
/// Brasília) liga o lembrete de treino; `null` = desligado.
/// `lastReminderOn` (AAAA-MM-DD) impede mandar o lembrete duas vezes no
/// mesmo dia, mesmo com mais de uma instância rodando.
model NotificationSettings {
  userId            String   @id
  reminderHour      Int?
  lastReminderOn    String?
  /// Avisos do personal (Configurações, EPIC-36). `alertInactiveDays` nulo
  /// desliga o aviso de aluno sem treinar.
  alertDaysChanged  Boolean  @default(true)
  alertInactiveDays Int?     @default(7)
  alertOverdue      Boolean  @default(true)
  alertProgramEnd   Boolean  @default(true)
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

/// Sessão de autenticação (Better Auth). Não é a fonte de autorização de
/// domínio — o contexto confiável (userId/role/tenantId) é derivado
/// server-side a partir da sessão válida, nunca aceito do cliente (ver
/// FIT-011, `AUTORIZACAO-E-PAPEIS.md`).
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Passkey (EPIC-33): entrar com digital, Face ID ou o bloqueio do
/// aparelho (WebAuthn, plugin de passkey do Better Auth). Só a chave
/// pública fica no banco; a privada nunca sai do aparelho.
model Passkey {
  id           String    @id @default(cuid())
  name         String?
  publicKey    String
  userId       String
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([credentialID])
  @@map("passkeys")
}

/// Credencial/provedor de autenticação (Better Auth). Para login por
/// e-mail e senha (único provedor desta História), o hash da senha fica em
/// `password` — nunca texto puro, nunca em log. `accountId` é o
/// identificador do usuário no provedor (aqui, o próprio e-mail
/// normalizado); `providerId` identifica o provedor ("credential").
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

/// Token de verificação (Better Auth) — ex.: confirmação de e-mail, redefinição
/// de senha. Parte do schema base exigido pelo provedor; esta História não
/// envia e-mails reais (fora do escopo — ver AUTENTICACAO-E-SESSAO.md), então
/// a tabela existe mas não é usada ativamente ainda.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

/// Tipo de workspace (FIT-100, EPIC-13). `PERSONAL` é o único tipo que
/// existia até esta História — todo `Tenant` já criado permanece
/// `PERSONAL` pelo `@default`, migration puramente aditiva, nenhuma linha
/// existente muda de sentido. `INDIVIDUAL` é o workspace do FitOS Livre:
/// administrado pelo próprio praticante, sem carteira de alunos.
enum TenantType {
  PERSONAL
  INDIVIDUAL
}

/// Unidade de isolamento multi-tenant. Até a FIT-100, "1 personal trainer =
/// 1 tenant" (`MODELO-MULTITENANT.md`); a partir daqui, um `Tenant` também
/// pode ser `INDIVIDUAL` (FitOS Livre) — mesma unidade de isolamento, dono
/// e nome, mas sem alunos/carteira/financeiro. Nenhuma regra de isolamento
/// muda: continua sendo `tenantId` derivado da sessão, nunca do cliente.
model Tenant {
  id                    String     @id @default(cuid())
  ownerId               String     @unique
  name                  String
  type                  TenantType @default(PERSONAL)
  createdAt             DateTime   @default(now())
  /// Quando a biblioteca inicial (programas, treinos e aeróbicos prontos)
  /// foi criada neste espaço; nunca recriada (EPIC-28).
  starterLibraryAt      DateTime?
  /// EPIC-32: última versão da biblioteca inicial já criada no espaço.
  starterLibraryVersion Int        @default(0)
  /// EPIC-33: o que quem entra pelo link de convite já recebe — o
  /// programa (cópia da biblioteca) e a mensalidade (valor e dia).
  inviteProgramId       String?
  inviteFeeCents        Int?
  inviteFeeDay          Int?
  /// Prescrição com que um exercício entra num treino (Configurações,
  /// EPIC-36). Nulo = padrão do FitOS (3 × 12, 60 s).
  defaultSets           Int?
  defaultReps           Int?
  defaultRestSeconds    Int?
  /// Respostas rápidas do personal no chat (EPIC-41); até salvar a
  /// primeira vez (`chatQuickRepliesSet`), valem as padrão.
  chatQuickReplies      String[]   @default([])
  chatQuickRepliesSet   Boolean    @default(false)
  /// Link de convite do personal (`/c/<código>`, EPIC-29): quem abre cria a
  /// própria conta de aluno neste espaço. Gerado no primeiro uso.
  inviteCode            String?    @unique
  /// Código de indicação do personal para outros personais (EPIC-47).
  referralCode          String?    @unique

  owner                    User                        @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  students                 Student[]
  exercises                Exercise[]
  trainingPlans            TrainingPlan[]
  workouts                 Workout[]
  workoutExercises         WorkoutExercise[]
  planAssignments          PlanAssignment[]
  workoutSessions          WorkoutSession[]
  workoutSessionResults    WorkoutSessionResult[]
  workoutSetResults        WorkoutSetResult[]
  assessments              Assessment[]
  bodyMeasurements         BodyMeasurement[]
  studentCharges           StudentCharge[]
  payments                 Payment[]
  chargeRecurrences        ChargeRecurrence[]
  saasSubscription         SaasSubscription?
  classRanking             ClassRanking?
  accessGrants             AdministrativeAccessGrant[]
  saasPayments             SaasPayment[]
  couponAudienceMembers    CouponAudienceMember[]
  couponRedemptions        CouponRedemption[]
  auditEvents              AuditEvent[]
  invitations              Invitation[]
  individualProfile        IndividualProfile?
  personalProfile          PersonalProfile?
  goals                    Goal[]
  evolutionPhotos          EvolutionPhoto[]
  paymentAccount           PaymentAccount?
  chatTopics               ChatTopic[]
  chatMessages             ChatMessage[]
  chatAttachments          ChatAttachment[]
  healthForms              HealthForm[]
  subscriptionDueReminders SubscriptionDueReminder[]
  referralsMade            PersonalReferral[]          @relation("ReferralReferrer")
  referralReceived         PersonalReferral?           @relation("ReferralReferred")
  scheduleSlots            ScheduleSlot[]
  scheduleEvents           ScheduleEvent[]
  workoutSessionRevisions  WorkoutSessionRevision[]

  @@map("tenants")
}

enum IndividualObjective {
  GANHAR_MASSA
  PERDER_PESO
  CONDICIONAMENTO_GERAL
  SAUDE_E_BEM_ESTAR
  OUTRO
}

enum ExperienceLevel {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
}

enum WeeklyAvailability {
  UM_A_DOIS_DIAS
  TRES_A_QUATRO_DIAS
  CINCO_OU_MAIS_DIAS
}

/// Configuração inicial do workspace individual (FIT-101, EPIC-13):
/// objetivo, experiência e disponibilidade informados no onboarding
/// "Treino sozinho". Existe no máximo 1 por tenant (`tenantId @unique`) —
/// preenchê-lo de novo (reabrir o onboarding) sempre atualiza o mesmo
/// registro, nunca cria um segundo. Puramente informativo nesta História:
/// não gera nenhuma prescrição automática (a FIT-102 decide como o
/// catálogo/builder usa isso, se usar).
model IndividualProfile {
  id                 String              @id @default(cuid())
  tenantId           String              @unique
  objective          IndividualObjective
  experienceLevel    ExperienceLevel
  weeklyAvailability WeeklyAvailability
  /// CPF/CNPJ do usuário (FIT-128, Issue #153) — exigido pelo Asaas em
  /// `POST /v3/customers` para a integração real de pagamento do plano
  /// pago do FitOS Livre (`individual-livre-v2`). Mesmo tratamento de
  /// `PersonalProfile.cpfCnpj`: obrigatório para toda nova submissão do
  /// onboarding, `null` só para perfis concluídos antes deste campo
  /// existir — nunca fabricado retroativamente.
  cpfCnpj            String?
  /// Sempre preenchido no momento da primeira submissão, nunca sobrescrito
  /// depois (mesmo princípio de "preserva o momento original" de
  /// `endStudentBond`/`softDeleteAssessment`) — reabrir o onboarding para
  /// mudar objetivo/experiência/disponibilidade nunca pede um novo aceite
  /// nem altera esta data (FIT-119). `null` para perfis criados antes deste
  /// campo existir (FIT-101 a FIT-118) — nunca fabricado retroativamente.
  termsAcceptedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("individual_profiles")
}

enum PersonalStudentRangeEstimate {
  COMECANDO_AGORA
  ATE_20
  DE_21_A_50
  MAIS_DE_50
}

/// Perfil profissional do Personal (FIT-113, EPIC-14, seção 7 do pacote):
/// dados complementares ao cadastro (FIT-009) — celular, CREF opcional,
/// faixa aproximada de alunos e o aceite dos termos. Existe no máximo 1
/// por tenant (`tenantId @unique`), mesmo padrão de `IndividualProfile`:
/// `null` significa "onboarding ainda não concluído" — `/painel` (FIT-012)
/// redireciona para `/onboarding-personal` enquanto for esse o caso,
/// exatamente como já faz para `IndividualProfile` nulo. Deliberadamente
/// sem `businessName` próprio: "nome do espaço/negócio" já existe como
/// `Tenant.name` (FIT-010) — este onboarding só oferece editá-lo, nunca
/// duplica a coluna.
model PersonalProfile {
  id                   String                       @id @default(cuid())
  tenantId             String                       @unique
  /// Opcional desde a EPIC-33: o cadastro não pede mais; o personal
  /// informa no Perfil ou ao cadastrar o cartão.
  phone                String?
  cref                 String?
  /// CPF/CNPJ do personal (FIT-128, Issue #153) — exigido pelo Asaas em
  /// `POST /v3/customers` para a integração real de pagamento, ainda não
  /// ligado (`src/modules/billing/asaasClient.ts`). Obrigatório para toda
  /// nova submissão do onboarding (`completePersonalOnboarding` valida com
  /// `isValidCpfCnpj`) — `null` só para perfis concluídos antes deste
  /// campo existir (mesmo princípio de `IndividualProfile.termsAcceptedAt`
  /// desde a FIT-119: nunca fabricado retroativamente; reabrir o
  /// onboarding passa a exigi-lo).
  cpfCnpj              String?
  studentRangeEstimate PersonalStudentRangeEstimate
  /// Sempre preenchido no momento da submissão (não um campo booleano) —
  /// rastreabilidade de quando o aceite ocorreu. Não existe hoje nenhuma
  /// página real de Termos de Uso/Política de Privacidade (mesma pendência
  /// já documentada no rodapé da landing, FIT-110) — o texto apresentado
  /// ao lado do aceite é honesto sobre isso ("em preparação"), nunca um
  /// link morto.
  termsAcceptedAt      DateTime
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("personal_profiles")
}

/// Aluno vinculado a exatamente 1 tenant. `userId` é único quando presente,
/// então cada User (aluno) tem no máximo 1 perfil de Student — multi-personal
/// por aluno exigiria nova decisão e migração planejada (fora do MVP).
///
/// `userId` é opcional (FIT-013): o personal cadastra o aluno (nome + e-mail)
/// antes de existir qualquer conta/sessão — o `User` só passa a existir na
/// ativação do convite (FIT-015). `email` vive no próprio `Student` porque,
/// até a ativação, não há `User` para guardá-lo; é o valor usado tanto para
/// o convite quanto, depois, deve corresponder ao e-mail do `User` vinculado.
/// Único por tenant (`@@unique([tenantId, email])`), não globalmente: dois
/// tenants diferentes podem cadastrar o mesmo e-mail antes de qualquer
/// ativação (a colisão real, se houver, só se manifesta na ativação, onde
/// `User.email` é globalmente único — tratado na FIT-015).
///
/// `@@unique([id, tenantId])` existe para ser referenciado por chave
/// composta a partir de PlanAssignment/WorkoutSession/Assessment/
/// StudentCharge, impedindo que uma dessas tabelas filhas aponte para um
/// Student de um tenant diferente do seu próprio `tenantId`.
model Student {
  id                   String        @id @default(cuid())
  tenantId             String
  userId               String?       @unique
  email                String
  displayName          String
  status               StudentStatus @default(ATIVO)
  endedAt              DateTime?
  endReason            String?
  endedByUserId        String?
  /// Objetivo que o aluno escolheu ao entrar pelo convite (EPIC-33).
  objective            String?
  /// "Meus dias" (EPIC-31): dias em que o aluno combinou treinar
  /// (SEGUNDA…DOMINGO). Vazio = os dias do programa.
  preferredDays        String[]      @default([])
  /// Autorização explícita para fotos de evolução (EPIC-35,
  /// REGRAS-DE-NEGOCIO seção 7): quando e por quem foi registrada. Nula =
  /// sem autorização, nenhuma foto pode ser enviada.
  /// CPF do aluno, pedido na primeira cobrança pelo app (EPIC-38): o
  /// Asaas exige CPF do pagador.
  cpf                  String?
  /// Cliente do aluno na conta Asaas do personal (zerado ao trocar a conta).
  asaasCustomerId      String?
  photoConsentAt       DateTime?
  photoConsentByUserId String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant              Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  endedByUser         User?                     @relation("StudentBondEndedBy", fields: [endedByUserId], references: [id], onDelete: Restrict)
  planAssignments     PlanAssignment[]
  workoutSessions     WorkoutSession[]
  assessments         Assessment[]
  charges             StudentCharge[]
  chargeRecurrences   ChargeRecurrence[]
  invitations         Invitation[]
  goals               Goal[]
  evolutionPhotos     EvolutionPhoto[]
  scoringReferences   ScoringReference[]
  periodGoals         PeriodGoal[]
  rankingEntries      ClassRankingParticipant[]
  chatTopics          ChatTopic[]
  healthForm          HealthForm?
  /// Aluno que indicou este (EPIC-47), quando entrou pelo link com `?ref=`.
  referredByStudentId String?
  referredBy          Student?                  @relation("StudentReferral", fields: [referredByStudentId], references: [id], onDelete: SetNull)
  referrals           Student[]                 @relation("StudentReferral")
  scheduleSlots       ScheduleSlot[]
  scheduleEvents      ScheduleEvent[]
  friendGroupMembers  FriendGroupMember[]

  @@unique([id, tenantId])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("students")
}

/// Convite de ativação de conta (FIT-015). Um por tentativa — gerar um novo
/// convite para o mesmo aluno cancela (nunca apaga) qualquer PENDENTE
/// anterior, preservando o histórico. Apenas o hash do token é armazenado
/// (`tokenHash`, SHA-256); o token bruto nunca é persistido, logado nem
/// incluído em evidência — existe apenas na memória do processo entre a
/// geração e a resposta HTTP ao personal.
///
/// `@@unique([studentId, tenantId])` seria incorreto aqui (impediria mais de
/// um convite por aluno ao longo do tempo) — o histórico é modelado como
/// múltiplas linhas com status diferentes, não uma linha só reescrita.
model Invitation {
  id         String           @id @default(cuid())
  tenantId   String
  studentId  String
  tokenHash  String           @unique
  status     InvitationStatus @default(PENDENTE)
  expiresAt  DateTime
  createdAt  DateTime         @default(now())
  acceptedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("invitations")
}

/// Catálogo de exercícios. `tenantId` nulo representa exercício global
/// (importado da API Ninjas e compartilhado); `tenantId` preenchido
/// representa exercício próprio do personal.
///
/// Exercise NÃO participa de FK composta com WorkoutExercise porque
/// `tenantId` pode ser nulo (global) — uma FK composta `[exerciseId, tenantId]`
/// exigiria igualdade exata e rejeitaria todo exercício global. A regra
/// "treino do tenant A não usa exercício privado do tenant B" é imposta por
/// TRIGGER em PostgreSQL (`enforce_workout_exercise_tenant`, ver migration
/// `20260916_add_tenant_composite_constraints`), não representável no
/// Prisma Schema. Documentado em MODELO-FISICO-DE-DADOS.md.
///
/// Um segundo TRIGGER (`enforce_exercise_tenant_immutability`, mesma
/// migration) protege alterações em `Exercise.tenantId`: rejeita transferir
/// um exercício privado para outro tenant, ou torná-lo privado de um tenant,
/// quando isso invalidaria um `WorkoutExercise` já existente de outro
/// tenant. Sem esse trigger, `enforce_workout_exercise_tenant` só valida a
/// criação/alteração do vínculo em `workout_exercises`, não uma alteração
/// posterior no próprio `Exercise`.
/// Campos de catálogo abaixo (`type` a `safetyInfo`, FIT-021) espelham o
/// contrato da Exercises API (ver `src/integrations/api-ninjas/types.ts` e
/// `docs/06-engenharia/arquitetura/adr/ADR-004-API-NINJAS-EXERCICIOS.md`) —
/// todos opcionais, preenchidos para `API_NINJAS` e, quando aplicável,
/// também usados por exercício `PERSONAL` (FIT-022). `externalId` para
/// `API_NINJAS` é uma chave de deduplicação determinística calculada pelo
/// FitOS (hash de nome+tipo+músculo+equipamento+dificuldade normalizados) —
/// a API não retorna um identificador estável; para `PERSONAL` permanece
/// `null` (múltiplas linhas com `externalId` nulo não colidem no índice
/// único, pois o PostgreSQL trata cada `NULL` como distinto).
model Exercise {
  id               String         @id @default(cuid())
  tenantId         String?
  name             String
  origin           ExerciseOrigin
  status           ExerciseStatus @default(ATIVO)
  externalId       String?
  type             String?
  muscle           String?
  equipments       String?
  difficulty       String?
  instructions     String?
  safetyInfo       String?
  /// FIT-111: URL pública HTTPS da ilustração do exercício. Migrado para
  /// Cloudflare R2 (storage compatível com S3) — nunca uma URL assinada,
  /// nunca um caminho interno exposto (a regra de assets do pacote proíbe
  /// ambos; um bucket R2 público satisfaz isso sem exigir autenticação para
  /// servir a imagem). Ver docs/06-engenharia/arquitetura/
  /// ARMAZENAMENTO-DE-MIDIA-EXERCICIOS.md e ADR-010. Alguns registros ainda
  /// podem conter o caminho estático local legado (`/media/exercises/
  /// <slug>.webp`, servido por `public/`) até serem migrados pela
  /// reexecução do importador — ambas as formas são URLs válidas para
  /// `next/image` (a local não passa por `remotePatterns`, a do R2 passa).
  /// `imageAlt` é texto funcional do movimento (não o nome do arquivo
  /// original), escrito pelo manifesto de importação.
  imageUrl         String?
  imageAlt         String?
  /// Funcional e CrossFit (feature 1): categorias do catálogo ("Funcional",
  /// "CrossFit"), músculos secundários (o filtro por músculo também os
  /// considera), nomes alternativos (inglês, siglas) e a métrica de registro
  /// (`shared/lib/exerciseCatalog.ts`).
  categories       String[]       @default([])
  secondaryMuscles String[]       @default([])
  aliases          String[]       @default([])
  metric           String?
  /// Nome, aliases e músculos em minúsculas e sem acento, para a busca
  /// ignorar acento e caixa (`exerciseSearchText`).
  searchText       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  performedSets    WorkoutSetResult[]     @relation("SetPerformedExercise")
  performedResults WorkoutSessionResult[] @relation("ResultPerformedExercise")

  @@unique([origin, externalId])
  @@index([tenantId])
  @@map("exercises")
}

/// Plano semanal: agrupa um ou mais modelos de treino (`Workout`), sempre
/// pertencente a um tenant.
///
/// `isSnapshot` (FIT-033, ADR-005) distingue as duas naturezas físicas que
/// esta mesma tabela carrega: `false` é o plano editável do personal
/// (aparece na listagem/builder, FIT-032); `true` é uma cópia imutável
/// criada no momento de uma atribuição (`PlanAssignment`) — nunca aparece
/// no builder, nunca é editada. Ambas são linhas normais de
/// `training_plans`; a distinção é só essa flag mais o TRIGGER descrito no
/// comentário de `Workout` abaixo, que a torna imutável na prática, não só
/// por convenção de leitura.
///
/// `isDraftBucket` (FIT-032) identifica o plano "rascunho" implícito
/// auto-provisionado por `ensureDraftTrainingPlanForTenant` (bootstrapping
/// desde a FIT-030) — no máximo um por tenant. Precisa ser um campo
/// explícito, não uma heurística por `createdAt`: se o personal criar um
/// plano real (FIT-032) antes de qualquer modelo avulso, "o primeiro plano
/// criado" deixaria de ser o rascunho, e um novo modelo avulso cairia
/// silenciosamente dentro do plano nomeado do personal. Nunca aparece na
/// listagem voltada ao personal (`listTrainingPlansForTenant`) — é um
/// detalhe de implementação, não um programa que o personal decidiu criar.
///
/// `@@unique([id, tenantId])` referenciado por chave composta a partir de
/// Workout e PlanAssignment.
model TrainingPlan {
  id            String             @id @default(cuid())
  tenantId      String
  name          String
  status        TrainingPlanStatus @default(ATIVO)
  durationWeeks Int?
  isSnapshot    Boolean            @default(false)
  isDraftBucket Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workouts        Workout[]
  planAssignments PlanAssignment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("training_plans")
}

/// Modelo de treino ("modelo de treino" no produto) dentro de um plano.
/// `tenantId` é denormalizado do TrainingPlan para permitir filtro direto
/// por tenant sem depender de join.
///
/// Sempre pertence a exatamente um `TrainingPlan` (FK obrigatória desde a
/// FIT-007) — "reutilizável" é resolvido por **duplicação** (FIT-031,
/// `REGRAS-DE-NEGOCIO.md`: "Duplicar um modelo cria uma nova entidade sem
/// vínculo de atualização automática"), nunca por uma relação
/// muitos-para-muitos entre Workout e TrainingPlan. Ver
/// `docs/06-engenharia/arquitetura/TREINOS-E-PLANOS.md`.
///
/// A relação com TrainingPlan usa chave composta `[trainingPlanId, tenantId]`
/// → `TrainingPlan.[id, tenantId]`: o PostgreSQL rejeita fisicamente um
/// Workout cujo `tenantId` seja diferente do `tenantId` do TrainingPlan
/// referenciado (impede treino do tenant A vinculado a plano do tenant B).
///
/// Imutabilidade pós-atribuição (FIT-033, ADR-005): quando o `TrainingPlan`
/// referenciado tem `isSnapshot: true`, um TRIGGER (`enforce_snapshot_immutability`,
/// ver migration `<timestamp>_add_workout_prescription_and_status`) rejeita
/// fisicamente qualquer INSERT/UPDATE/DELETE neste Workout e em seus
/// `WorkoutExercise` — não representável no Prisma Schema, mesma técnica já
/// usada pelos triggers de isolamento (FIT-007) e de imutabilidade de
/// `Exercise.tenantId`.
///
/// `@@unique([id, tenantId])` referenciado por chave composta a partir de
/// WorkoutExercise e WorkoutSession.
model Workout {
  id             String        @id @default(cuid())
  tenantId       String
  trainingPlanId String
  name           String
  position       Int
  status         WorkoutStatus @default(ATIVO)
  suggestedDays  String[]      @default([])
  /// Funcional e CrossFit (feature 1): blocos do treino, em ordem
  /// (`shared/lib/workoutBlocks.ts`): circuito, AMRAP, EMOM ou For Time,
  /// com voltas, janela, intervalos ou limite. Vazio = séries tradicionais.
  blocks         Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trainingPlan     TrainingPlan      @relation(fields: [trainingPlanId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workoutExercises WorkoutExercise[]
  workoutSessions  WorkoutSession[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([trainingPlanId, tenantId])
  @@map("workouts")
}

/// Item de um treino, referenciando um exercício do catálogo.
///
/// A relação com Workout usa chave composta `[workoutId, tenantId]` →
/// `Workout.[id, tenantId]`: impede item de treino do tenant A apontar para
/// um Workout do tenant B.
///
/// A relação com Exercise permanece por FK simples (`exerciseId` → `id`)
/// porque Exercise.tenantId pode ser nulo (catálogo global). A regra
/// "exercício privado só pode ser usado por treino do mesmo tenant" é
/// imposta por TRIGGER em PostgreSQL — ver comentário no model Exercise e
/// migration `20260916_add_tenant_composite_constraints`.
/// Parâmetros de prescrição (FIT-030, `docs/03-design/CRITICAL-SCREEN-SPECS.md`,
/// "Builder de treino"): séries, repetições OU duração (conforme o
/// exercício — nenhum dos dois é obrigatório ao mesmo tempo), carga
/// (texto livre — nem sempre um número em kg: peso corporal, elástico,
/// "RM"; mesmo padrão de `Exercise.difficulty`/`equipments`), descanso e
/// observação. RPE/RIR e vídeo são pós-MVP, não representados aqui.
model WorkoutExercise {
  id                   String           @id @default(cuid())
  tenantId             String
  workoutId            String
  exerciseId           String
  position             Int
  sets                 Int?
  reps                 Int?
  durationSeconds      Int?
  load                 String?
  restSeconds          Int?
  notes                String?
  /// Só em item aeróbico (exercício `type = "Aeróbico"`): o tempo fica em
  /// `durationSeconds` e não há séries nem repetições.
  intensity            CardioIntensity?
  /// Funcional e CrossFit (feature 1): bloco do treino a que o item
  /// pertence (`Workout.blocks[].key`); sem bloco, séries tradicionais.
  blockKey             String?
  /// Metas por métrica: distância (m) e calorias do equipamento.
  targetDistanceMeters Int?
  targetCalories       Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workout  Workout  @relation(fields: [workoutId, tenantId], references: [id, tenantId], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  workoutSessionResults WorkoutSessionResult[]
  workoutSetResults     WorkoutSetResult[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([workoutId, tenantId])
  @@map("workout_exercises")
}

/// Versão de plano atribuída a um aluno. Preserva histórico: alterar o
/// TrainingPlan original não altera atribuições já existentes.
///
/// Ambas as relações (Student e TrainingPlan) usam chave composta com
/// `tenantId`: impede atribuir a um aluno de outro tenant, e impede
/// atribuir um plano de outro tenant.
/// `trainingPlanId` (FIT-033) sempre aponta para uma cópia imutável
/// (`TrainingPlan.isSnapshot: true`, ADR-005) criada no momento da
/// atribuição — nunca para o plano editável do personal. `endedAt` marca
/// o encerramento controlado (nova atribuição para o mesmo aluno, ou
/// encerramento explícito sem substituição) — `null` enquanto `active`.
/// No máximo uma atribuição `active: true` por aluno, garantido por um
/// índice único parcial (não representável no Prisma Schema — ver
/// migration `20260920010000_add_plan_assignment_lifecycle`).
model PlanAssignment {
  id             String    @id @default(cuid())
  tenantId       String
  studentId      String
  trainingPlanId String
  active         Boolean   @default(true)
  assignedAt     DateTime  @default(now())
  endedAt        DateTime?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId])
  @@index([studentId, tenantId])
  @@index([trainingPlanId, tenantId])
  @@map("plan_assignments")
}

/// Execução de um treino por um aluno (FIT-041).
///
/// Ambas as relações (Student e Workout) usam chave composta com
/// `tenantId`: impede sessão com aluno e treino de tenants diferentes.
/// `workoutId` sempre aponta para um `Workout` do plano-snapshot da
/// atribuição ativa no momento em que a sessão foi iniciada (ADR-005) —
/// nunca o modelo editável do personal; como o snapshot é imutável, o
/// histórico de execução nunca é recalculado, mesmo que o aluno seja
/// reatribuído a outro plano depois (`REGRAS-DE-NEGOCIO.md`, seção 6).
///
/// `PLANEJADA` (`REGRAS-DE-NEGOCIO.md`) nunca é atingido nesta MVP: não
/// existe um fluxo de "agendar sessão" separado de "iniciar" — o próprio
/// "iniciar" já cria a sessão em `EM_ANDAMENTO`. O valor do enum
/// permanece (é a nomenclatura do produto), mas nenhuma função deste
/// módulo o produz — decisão de escopo registrada em
/// `docs/06-engenharia/arquitetura/EXPERIENCIA-DO-ALUNO.md`.
///
/// No máximo uma sessão `EM_ANDAMENTO` por aluno, garantido por um índice
/// único parcial (não representável no Prisma Schema — ver migration
/// `20260920020000_add_workout_session_results`).
model WorkoutSession {
  id                      String               @id @default(cuid())
  tenantId                String
  studentId               String
  workoutId               String
  status                  WorkoutSessionStatus @default(EM_ANDAMENTO)
  startedAt               DateTime             @default(now())
  endedAt                 DateTime?
  /// BK-13 (EPIC-19/20): esforço percebido de 1 (leve) a 5 (no limite),
  /// informado ao concluir. CHECK no banco garante a faixa.
  perceivedEffort         Int?
  /// BK-14 (FIT-153): tempo ativo da sessão em segundos, descontando as
  /// pausas do cronômetro. Informado ao concluir; nunca maior que o tempo
  /// de relógio entre `startedAt` e `endedAt`.
  activeSeconds           Int?
  /// Treino avulso (FitOS Livre): o que o praticante escolheu treinar
  /// (regiões e grupos musculares, `src/shared/lib/workoutFocus.ts`).
  focus                   String[]             @default([])
  /// Base das novas features (Fase 0): LIVE = feito com o cronômetro;
  /// RETROATIVO = registrado depois. `performedAt` é quando o treino
  /// aconteceu (nulo no LIVE: vale `startedAt`); `recordedAt`, quando foi
  /// registrado. `declaredDurationSeconds`: duração total informada no
  /// retroativo (declaratória, sem cronômetro). `operationKey` evita
  /// registro duplicado por retry ou clique repetido.
  mode                    WorkoutSessionMode   @default(LIVE)
  performedAt             DateTime?
  recordedAt              DateTime             @default(now())
  declaredDurationSeconds Int?
  operationKey            String?              @unique

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workout Workout @relation(fields: [workoutId, tenantId], references: [id, tenantId], onDelete: Restrict)

  results      WorkoutSessionResult[]
  setResults   WorkoutSetResult[]
  chatTopic    ChatTopic?
  evidences    WorkoutEvidencePhoto[]
  score        SessionScore?
  blockResults WorkoutBlockResult[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([studentId, tenantId])
  @@index([workoutId, tenantId])
  @@map("workout_sessions")
}

enum WorkoutSessionMode {
  LIVE
  RETROATIVO
}

/// Foto de evidência do treino (Fase 0): pelo menos uma libera os pontos
/// da gamificação. Mesmo padrão das fotos de evolução: reduzida no
/// aparelho, guardada no banco, lida só por rota autenticada. É uma
/// evidência enviada pelo cliente; não comprova sozinha carga, duração ou
/// data. `sha256` impede a mesma foto duas vezes no mesmo treino.
model WorkoutEvidencePhoto {
  id           String   @id @default(cuid())
  tenantId     String
  sessionId    String
  uploadedById String
  mimeType     String
  width        Int
  height       Int
  sizeBytes    Int
  sha256       String
  data         Bytes
  createdAt    DateTime @default(now())

  session WorkoutSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([sessionId, sha256])
  @@index([tenantId])
  @@map("workout_evidence_photos")
}

/// Resultado executado de um item do treino, dentro de uma sessão
/// (FIT-041). Um registro por `WorkoutExercise` por sessão — "editar" um
/// resultado já registrado é um upsert (nunca uma segunda linha), o que
/// também é a própria defesa física contra dupla submissão: reenviar o
/// mesmo registro nunca duplica, apenas substitui os valores.
///
/// Campos "completed" são deliberadamente independentes dos prescritos em
/// `WorkoutExercise` (nunca os sobrescreve) — "o aluno pode informar
/// valores executados diferentes dos prescritos" (`REGRAS-DE-NEGOCIO.md`,
/// seção 6).
model WorkoutSessionResult {
  id                       String   @id @default(cuid())
  tenantId                 String
  workoutSessionId         String
  workoutExerciseId        String
  setsCompleted            Int?
  repsCompleted            Int?
  durationSecondsCompleted Int?
  loadUsed                 String?
  recordedAt               DateTime @default(now())
  updatedAt                DateTime @updatedAt
  /// Exercício feito no lugar do prescrito (EPIC-38), como nas séries.
  performedExerciseId      String?

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workoutSession  WorkoutSession  @relation(fields: [workoutSessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId, tenantId], references: [id, tenantId], onDelete: Restrict)

  performedExercise Exercise? @relation("ResultPerformedExercise", fields: [performedExerciseId], references: [id], onDelete: SetNull)

  @@unique([workoutSessionId, workoutExerciseId])
  @@index([tenantId])
  @@index([workoutSessionId, tenantId])
  @@map("workout_session_results")
}

/// Série executada (BK-11, FIT-153, ADR-015): uma linha por série de um
/// item do treino, na sessão. `WorkoutSessionResult` (agregado por item)
/// continua sendo mantido a cada série, para não quebrar histórico,
/// recordes e telas antigas. Carga em gramas (Int), como `weightGrams`.
/// Registrar a mesma série de novo substitui os valores (upsert por
/// sessão + item + número da série).
model WorkoutSetResult {
  id                  String   @id @default(cuid())
  tenantId            String
  workoutSessionId    String
  workoutExerciseId   String
  setNumber           Int
  reps                Int?
  durationSeconds     Int?
  loadGrams           Int?
  completedAt         DateTime @default(now())
  /// "Aparelho ocupado" (EPIC-38): exercício feito no lugar do prescrito,
  /// só nesta sessão. Nulo = o do treino.
  performedExerciseId String?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workoutSession    WorkoutSession  @relation(fields: [workoutSessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId, tenantId], references: [id, tenantId], onDelete: Restrict)
  performedExercise Exercise?       @relation("SetPerformedExercise", fields: [performedExerciseId], references: [id], onDelete: SetNull)

  @@unique([workoutSessionId, workoutExerciseId, setNumber])
  @@index([tenantId])
  @@index([workoutExerciseId, tenantId])
  @@map("workout_set_results")
}

/// Avaliação/evolução manual do aluno. Peso em gramas (Int) para evitar
/// ponto flutuante binário em dado sensível a precisão.
///
/// A relação com Student usa chave composta com `tenantId`: impede
/// avaliação de aluno de outro tenant.
///
/// `authorUserId` permanece FK simples para User — NÃO há constraint física
/// garantindo que o autor pertença ao mesmo tenant do registro. Essa é uma
/// lacuna conhecida (ver "Correção obrigatória 5" / MODELO-FISICO-DE-DADOS.md):
/// User ainda não tem um modelo físico de membership/associação a tenant
/// (personal é dono via Tenant.ownerId, aluno via Student.userId, mas não há
/// uma tabela genérica "este User pertence a este Tenant" que pudesse ser
/// referenciada por chave composta). Implementar essa constraint agora
/// exigiria criar esse modelo de membership — fora do escopo mínimo desta
/// correção — e depende, em última instância, da futura camada de
/// autenticação/autorização.
/// `bodyFatTenthPercent` guarda o percentual de gordura com uma casa
/// decimal sem ponto flutuante binário (ex.: 18,5% → 185) — mesma técnica
/// de `weightGrams`. `notes` é a observação (FIT-042). `deletedAt` marca
/// exclusão lógica — "Exclusões de avaliações devem ser lógicas e
/// auditáveis" (`REGRAS-DE-NEGOCIO.md`, seção 7); nenhuma função deste
/// módulo permite editar uma avaliação já registrada (mesma filosofia de
/// "preserva histórico" já usada em toda esta base) — só criar e excluir
/// logicamente.
model Assessment {
  id                  String    @id @default(cuid())
  tenantId            String
  studentId           String
  authorUserId        String
  weightGrams         Int?
  bodyFatTenthPercent Int?
  notes               String?
  recordedAt          DateTime  @default(now())
  deletedAt           DateTime?
  deletedByUserId     String?

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  authorUser User    @relation("AssessmentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  measurements BodyMeasurement[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("assessments")
}

/// Medida corporal individual vinculada a uma avaliação (FIT-042) —
/// `docs/01-produto/MODELO-DE-DADOS.md`: "Medida corporal: avaliação,
/// tipo, valor, unidade". `type` é um conjunto fechado (`BodyMeasurementType`,
/// não texto livre — "medidas permitidas" no texto da História), unidade
/// sempre centímetros nesta MVP (nenhum produto pede unidade variável;
/// decisão de escopo registrada em
/// `docs/06-engenharia/arquitetura/EXPERIENCIA-DO-ALUNO.md`) — `valueMillimeters`
/// guarda o valor em milímetros (Int) pela mesma razão de `weightGrams`.
/// Nunca editada depois de criada — exclusão lógica é sempre da
/// `Assessment` inteira, nunca de uma medida isolada.
model BodyMeasurement {
  id               String              @id @default(cuid())
  tenantId         String
  assessmentId     String
  type             BodyMeasurementType
  valueMillimeters Int

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([assessmentId, type])
  @@index([tenantId])
  @@index([assessmentId, tenantId])
  @@map("body_measurements")
}

enum BodyMeasurementType {
  CINTURA
  QUADRIL
  PEITO
  BRACO
  COXA
  PANTURRILHA
}

/// Meta pessoal de evolução (FIT-104, EPIC-13 — FitOS Livre), genérica por
/// `[studentId, tenantId]` como todo o resto do domínio de evolução —
/// nunca amarrada a `INDIVIDUAL`: um aluno com personal poderá ganhar a
/// mesma tela no futuro sem migração nova. Só o próprio `Student` (ou,
/// hoje, só o praticante individual via `ensureStudentForIndividual`)
/// cria/conclui/abandona as próprias metas — nenhuma função de
/// `goals.ts` aceita um `actorUserId` diferente do dono, ao contrário de
/// `Assessment` (que é sempre autorada por outra pessoa, o personal).
/// `description` é texto livre (não um catálogo fechado — "perder 5kg",
/// "correr 5km" e "aumentar carga do supino" não cabem em um enum sem
/// engessar o produto). `completedAt` só é preenchido ao concluir; uma
/// meta abandonada não tem `completedAt` (não foi alcançada).
model Goal {
  id          String     @id @default(cuid())
  tenantId    String
  studentId   String
  description String
  targetDate  DateTime?
  status      GoalStatus @default(EM_ANDAMENTO)
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("goals")
}

enum GoalStatus {
  EM_ANDAMENTO
  CONCLUIDA
  ABANDONADA
}

/// Controle manual de cobrança do aluno. `amountCents` em centavos (Int)
/// para evitar ponto flutuante binário em valor monetário. Não possui
/// nenhuma FK ou trigger a partir de SaasSubscription — os dois domínios
/// financeiros permanecem estruturalmente separados.
///
/// A relação com Student usa chave composta com `tenantId`: impede cobrança
/// do tenant A vinculada a aluno do tenant B.
///
/// `referenceMonth` (competência) e `dueDate` (vencimento) têm significados
/// distintos por regra de produto (`REGRAS-DE-NEGOCIO.md` seção 8) — nunca
/// devem ser tratados como o mesmo campo, mesmo quando coincidem no valor.
/// `status` é sempre um dos quatro estados persistidos (`pendente`/`pago`/
/// `atrasado`/`cancelado`, regra já registrada desde a FIT-007 no README de
/// `src/modules/student-finance/`) — "a vencer" nunca é armazenado, é sempre
/// apresentação calculada sobre `pendente` com `dueDate` futuro.
/// `cancelReason`/`cancelledAt` só são preenchidos por `CANCELADO` — cancelar
/// nunca equivale a pagar (seção 8).
model StudentCharge {
  id                String              @id @default(cuid())
  tenantId          String
  studentId         String
  description       String
  status            StudentChargeStatus @default(PENDENTE)
  amountCents       Int
  referenceMonth    DateTime
  dueDate           DateTime
  cancelReason      String?
  cancelledAt       DateTime?
  recurrenceId      String?
  /// Cobrança gerada na conta Asaas do personal (EPIC-38): id e link de
  /// pagamento (Pix, boleto ou cartão). A baixa vem pelo webhook.
  externalPaymentId String?             @unique
  paymentUrl        String?
  createdAt         DateTime            @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  payment    Payment?
  recurrence ChargeRecurrence? @relation(fields: [recurrenceId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([recurrenceId, referenceMonth])
  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("student_charges")
}

enum ChargeRecurrenceStatus {
  ATIVA
  ENCERRADA
}

/// Cobrança recorrente (FIT-052): "cobrança recorrente gera lançamentos
/// independentes por competência" (`REGRAS-DE-NEGOCIO.md` seção 8) — cada
/// `StudentCharge` gerado é uma cópia física independente, nunca uma
/// referência viva; alterar `amountCents`/`description` aqui nunca muda um
/// `StudentCharge` já gerado. Sem infraestrutura de agendamento/cron nesta
/// MVP (mesma decisão da FIT-020/023): a geração é sempre uma ação
/// explícita do personal, nunca automática.
model ChargeRecurrence {
  id            String                 @id @default(cuid())
  tenantId      String
  studentId     String
  description   String
  amountCents   Int
  dueDayOfMonth Int
  status        ChargeRecurrenceStatus @default(ATIVA)
  createdAt     DateTime               @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  charges StudentCharge[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([studentId, tenantId])
  @@map("charge_recurrences")
}

/// Quitação de uma cobrança (FIT-051). Entidade própria — nunca campos
/// diretamente em `StudentCharge` — porque "cobrança pode possuir zero ou
/// um pagamento no MVP" (`MODELO-DE-DADOS.md`), preservando o histórico da
/// quitação mesmo que, numa iteração futura, o MVP passe a suportar reversão
/// de pagamento (o registro em si nunca é a única fonte de verdade do
/// status — `StudentCharge.status` é). Pagamento parcial fica fora do MVP
/// (seção 8): o valor recebido é só histórico, sem reconciliação de saldo.
/// Toda escrita aqui gera `AuditEvent` (seção 9 lista "pagamento"
/// explicitamente, ao contrário de `WorkoutSession`/FIT-041).
model Payment {
  id               String   @id @default(cuid())
  tenantId         String
  studentChargeId  String   @unique
  amountCentsPaid  Int
  paidAt           DateTime
  method           String
  recordedByUserId String
  createdAt        DateTime @default(now())

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  studentCharge  StudentCharge @relation(fields: [studentChargeId], references: [id], onDelete: Restrict)
  recordedByUser User          @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("payments")
}

/// Catálogo de planos comerciais (FIT-090/FIT-122) — preço, ciclo, limite
/// de alunos e teste grátis nunca são valores fixos no código, sempre uma
/// linha desta tabela (`REGRAS-DE-NEGOCIO.md`/`EPIC-12-MONETIZACAO.md`:
/// "planos, preços, limites... configuráveis — nunca valores fixos no
/// código"). `audience` reaproveita `TenantType` (nunca um enum paralelo
/// para o mesmo conceito): um plano `PERSONAL` nunca aparece para um
/// tenant `INDIVIDUAL`, e vice-versa. `studentLimit` só é significativo
/// para `PERSONAL` (limite de alunos ativos); sempre `null` (sem limite)
/// para `INDIVIDUAL`, que não tem alunos.
///
/// "Versionamento de oferta": um plano já contratado nunca tem preço ou
/// limite editados em cima da mesma linha — muda-se a oferta criando uma
/// nova linha (`slug` novo) e marcando a antiga `active=false`, mesmo
/// princípio de "nunca editar, sempre um novo registro" já usado em
/// `TrainingPlan`/`PlanAssignment`. `active=false` só impede nova
/// contratação; quem já assina um plano retirado continua com ele até
/// trocar ou cancelar.
model Plan {
  id           String       @id @default(cuid())
  slug         String       @unique
  audience     TenantType
  name         String
  description  String?
  priceCents   Int          @default(0)
  billingCycle BillingCycle
  studentLimit Int?
  trialDays    Int?
  position     Int          @default(0)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  subscriptions SaasSubscription[]

  @@index([audience, active])
  @@map("plans")
}

/// Assinatura SaaS do FitOS (FIT-090/FIT-122) — `PERSONAL` contratando o
/// próprio negócio ou `INDIVIDUAL` assinando o FitOS Livre (FIT-105);
/// `Plan.audience` sempre confere com `Tenant.type`, verificado em
/// `src/modules/billing/subscriptions.ts`, nunca só na UI. `tenantId`
/// único: no máximo 1 assinatura por tenant (linha reaproveitada entre
/// contratação inicial, troca de plano e cancelamento — não um histórico;
/// ledger/conciliação completos permanecem fora de escopo, FIT-099).
/// Estruturalmente separada de StudentCharge — nenhuma relação entre os
/// dois modelos. `provider` registra o meio de cobrança real
/// (Asaas/Mercado Pago, FIT-091) — enquanto nenhum gateway estiver
/// integrado, todo plano é de valor zero e `provider` grava o sentinela
/// documentado em `src/modules/billing/subscriptions.ts`, nunca um nome de
/// provedor fictício.
model SaasSubscription {
  id                     String                 @id @default(cuid())
  tenantId               String                 @unique
  planId                 String
  status                 SaasSubscriptionStatus @default(ATIVA)
  provider               String
  /// Id do cliente/assinatura reais no Asaas (FIT-128, ADR-010) — só
  /// preenchidos quando a ligação de melhor esforço em
  /// `tryEnsureAsaasSubscription` (`src/modules/billing/subscriptions.ts`)
  /// tiver sucesso. `null` enquanto `provider` for `NO_PAYMENT_PROVIDER`
  /// (inclui todo tenant `INDIVIDUAL` — `IndividualProfile` ainda não
  /// coleta CPF/CNPJ, gap conhecido) e sempre para planos de preço zero.
  externalCustomerId     String?
  externalSubscriptionId String?
  /// Últimos 4 dígitos e bandeira do cartão tokenizado no Asaas (FIT-128,
  /// checkout embutido no FitOS — nunca o número completo, nunca o CVV,
  /// nunca o token em si: `attachCreditCardToSubscription`
  /// (`src/modules/billing/checkout.ts`) só grava o que a própria resposta
  /// de `POST /v3/creditCard/tokenize` já devolve mascarado, exclusivamente
  /// para exibição em `/painel/assinatura` ("Cartão terminado em ****").
  /// `null` enquanto nenhum cartão tiver sido cadastrado — nunca obrigatório
  /// para um plano de preço zero.
  creditCardLast4        String?
  creditCardBrand        String?
  canceledAt             DateTime?
  canceledReason         String?
  /// Fim do período de teste grátis desta contratação — `null` quando não
  /// há trial em curso (plano sem `trialDays`, trial já expirado/consumido,
  /// ou nunca contratado). Nunca reiniciado numa troca de plano dentro do
  /// mesmo tenant — ver `trialUsedAt` (FIT-127).
  trialEndsAt            DateTime?
  /// Marca a primeira vez que este tenant recebeu um trial, para sempre —
  /// nunca é limpo, nem numa troca de plano. `subscribeTenantToPlan` só
  /// concede um novo `trialEndsAt` quando este campo ainda está `null`;
  /// nunca reinicia o trial trocando de plano (regra explícita do EPIC-16).
  trialUsedAt            DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  accessGrants AdministrativeAccessGrant[]

  @@index([planId])
  @@map("saas_subscriptions")
}

/// Renovação de gratuidade (feature 4): o administrador concede dias de
/// acesso gratuito a um personal ou FitOS Livre. Benefício separado do
/// teste inicial: `trialEndsAt`/`trialUsedAt` nunca mudam. `endsAt` é
/// exclusivo; vencer é derivado da data (sem job). SYNCING/FAILED ficam
/// para o ajuste da cobrança no Asaas; só ACTIVE libera acesso.
enum AccessGrantState {
  ACTIVE
  SYNCING
  FAILED
  REVOKED
}

model AdministrativeAccessGrant {
  id              String           @id @default(cuid())
  tenantId        String
  subscriptionId  String
  /// Administrador que concedeu (sem FK: o histórico fica mesmo se a conta sair).
  actorAdminId    String
  days            Int
  startsAt        DateTime
  endsAt          DateTime
  reasonCode      String
  reasonText      String?
  state           AccessGrantState @default(ACTIVE)
  /// Chave idempotente do formulário: repetir o envio não soma dias.
  operationKey    String           @unique
  revokedAt       DateTime?
  revokedById     String?
  revokeReason    String?
  /// Cobrança no Asaas (AAAA-MM-DD): próxima cobrança antes e a pedida.
  /// SYNCING até o Asaas confirmar `targetDueDate`; reconciliação refaz.
  previousDueDate String?
  targetDueDate   String?
  syncAttempts    Int              @default(0)
  syncError       String?
  syncedAt        DateTime?
  createdAt       DateTime         @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription SaasSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([tenantId, state, endsAt])
  @@index([subscriptionId])
  @@map("administrative_access_grants")
}

/// Trilha de auditoria das ações de benefício do administrador.
model AdminBenefitAudit {
  id         String   @id @default(cuid())
  actorId    String
  tenantId   String
  grantId    String
  operation  String
  before     Json?
  after      Json?
  reason     String
  occurredAt DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@map("admin_benefit_audits")
}

/// Evento de auditoria de alteração crítica. Nunca deve registrar senha,
/// token, chave ou conteúdo de credencial (docs/01-produto/REGRAS-DE-NEGOCIO.md).
///
/// `actorUserId` permanece FK simples para User — mesma lacuna conhecida de
/// `Assessment.authorUserId` (ver comentário lá e MODELO-FISICO-DE-DADOS.md):
/// nenhuma constraint física garante que o ator pertença ao tenant do evento.
model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String
  action      String
  entityType  String
  entityId    String
  occurredAt  DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User   @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("audit_events")
}

/// Foto de perfil (EPIC-35). Guardada no banco, já reduzida no aparelho
/// (quadrada, até 512px), e servida por `/api/avatar/[userId]` só para
/// quem está autenticado. `User.image` aponta para essa rota com `?v=`.
model UserAvatar {
  userId    String   @id
  mimeType  String
  data      Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// Foto de evolução do aluno (EPIC-35): frente, lado ou costas, na data da
/// avaliação. Só com `Student.photoConsentAt`; vista só pelo próprio aluno
/// e pelo personal do tenant, por `/api/fotos-evolucao/[id]`.
model EvolutionPhoto {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  uploadedById String
  pose         String
  takenAt      DateTime @default(now())
  mimeType     String
  width        Int
  height       Int
  data         Bytes
  createdAt    DateTime @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student    Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploadedBy User    @relation("EvolutionPhotoUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([studentId, tenantId, takenAt])
  @@map("evolution_photos")
}

/// Aviso já enviado ao personal (EPIC-36): um por motivo e referência
/// (aluno sem treinar desde a última sessão, cobrança atrasada, programa
/// que terminou). Evita repetir o mesmo aviso a cada rodada.
model PersonalAlert {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  refKey    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refKey])
  @@map("personal_alerts")
}

/// Conta de recebimento do personal (EPIC-38): uma subconta Asaas criada
/// pelo FitOS em nome dele, para cobrar os alunos pelo app. O dinheiro cai
/// na subconta do personal (o FitOS fica com 2% por split); a chave da
/// subconta fica criptografada e o aviso de pagamento dá a baixa.
model PaymentAccount {
  tenantId         String    @id
  provider         String
  /// "producao" ou "sandbox", pela chave.
  environment      String
  apiKeyEncrypted  String
  /// Identifica a conta na URL do webhook; `webhookSecret` vai no cabeçalho.
  webhookToken     String    @unique
  webhookSecret    String
  webhookId        String?
  connectedAt      DateTime  @default(now())
  /// Subconta Asaas criada pelo FitOS (EPIC-38): id, carteira e situação da
  /// verificação de identidade ("PENDENTE", "APROVADA", "RECUSADA").
  asaasAccountId   String?
  walletId         String?
  status           String    @default("PENDENTE")
  onboardingUrl    String?
  statusCheckedAt  DateTime?
  /// Chave Pix do personal para os saques.
  payoutPixKey     String?
  payoutPixKeyType String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("payment_accounts")
}

/// Assunto do chat entre aluno e personal (EPIC-39): uma categoria
/// (exercício, treino, dor, agenda, pagamento, outro), o exercício quando
/// é sobre um, e a situação (aberto/resolvido). As mensagens ficam dentro.
model ChatTopic {
  id                    String    @id @default(cuid())
  tenantId              String
  studentId             String
  category              String
  exerciseId            String?
  /// Nome do exercício no momento da pergunta (o treino pode mudar depois).
  exerciseName          String?
  /// Comentário depois do treino (EPIC-42): a sessão e o nome do treino.
  workoutSessionId      String?   @unique
  workoutName           String?
  resolvedAt            DateTime?
  lastMessageAt         DateTime  @default(now())
  lastStudentMessageAt  DateTime?
  lastPersonalMessageAt DateTime?
  studentReadAt         DateTime?
  personalReadAt        DateTime?
  createdAt             DateTime  @default(now())

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student        Student         @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)
  messages       ChatMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([studentId, tenantId])
  @@map("chat_topics")
}

model ChatMessage {
  id           String   @id @default(cuid())
  tenantId     String
  topicId      String
  authorUserId String
  fromStudent  Boolean
  body         String
  createdAt    DateTime @default(now())

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  topic      ChatTopic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author     User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  attachment ChatAttachment?

  @@index([topicId, createdAt])
  @@map("chat_messages")
}

/// Vídeo da execução ou foto anexada a uma mensagem (EPIC-40). Fica no
/// banco, sem URL pública: toda leitura passa pela rota autenticada. O
/// conteúdo é apagado depois de 90 dias (a mensagem fica, com o aviso).
model ChatAttachment {
  id          String    @id @default(cuid())
  tenantId    String
  messageId   String    @unique
  kind        String
  mimeType    String
  sizeBytes   Int
  durationSec Int?
  width       Int?
  height      Int?
  data        Bytes?
  expiredAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("chat_attachments")
}

/// Ficha de saúde do aluno (EPIC-46): anamnese curta e PAR-Q. Uma por
/// aluno (a resposta mais recente). Dado sensível: só o aluno e o
/// personal do vínculo veem.
model HealthForm {
  id             String   @id @default(cuid())
  tenantId       String
  studentId      String   @unique
  answers        Json
  /// Quantas respostas "sim" no PAR-Q (0 = liberado para começar).
  parqYes        Int
  filledByUserId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  filledBy User    @relation("HealthFormFiller", fields: [filledByUserId], references: [id], onDelete: Cascade)

  @@unique([studentId, tenantId])
  @@map("health_forms")
}

/// Indicação de personal para personal (EPIC-47): o indicado ganha 30 dias
/// a mais de teste; quando o primeiro pagamento dele é confirmado, quem
/// indicou ganha um mês (`rewardedAt`).
model PersonalReferral {
  id               String    @id @default(cuid())
  referrerTenantId String
  referredTenantId String    @unique
  createdAt        DateTime  @default(now())
  rewardedAt       DateTime?

  referrer Tenant @relation("ReferralReferrer", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referred Tenant @relation("ReferralReferred", fields: [referredTenantId], references: [id], onDelete: Cascade)

  @@index([referrerTenantId])
  @@map("personal_referrals")
}

/// Horário fixo de um aluno (EPIC-48): toda semana, no dia e hora
/// combinados (horário de Brasília, minutos desde 0h).
model ScheduleSlot {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  weekday         Int
  startMinutes    Int
  durationMinutes Int       @default(60)
  location        String?
  /// Primeiro dia (AAAA-MM-DD) em que vale; antes disso não aparece.
  startsOn        String
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  endedAt         DateTime?

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  events  ScheduleEvent[]

  @@index([tenantId, active])
  @@index([studentId, tenantId])
  @@map("schedule_slots")
}

/// Uma aula num dia (EPIC-48): a situação de uma ocorrência do horário fixo
/// (`slotId` + `originalDate`: feita, falta, desmarcada) ou uma aula avulsa
/// / reposição (`slotId` nulo).
model ScheduleEvent {
  id              String   @id @default(cuid())
  tenantId        String
  studentId       String
  slotId          String?
  originalDate    String?
  date            String
  startMinutes    Int
  durationMinutes Int      @default(60)
  /// AGENDADA, FEITA, FALTA ou DESMARCADA.
  status          String   @default("AGENDADA")
  note            String?
  updatedByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)
  slot    ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId, originalDate])
  @@index([tenantId, date])
  @@index([studentId, tenantId, date])
  @@map("schedule_events")
}

/// Música em um toque (PRD v2.1): o serviço que o usuário prefere abrir
/// durante o treino. Só a preferência; nada de conta, token ou o que toca.
model MusicPreference {
  userId    String   @id
  provider  String
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("music_preferences")
}

/// FitOS Desafios (feature 3, ADR-019): referência individual de um
/// exercício, congelada na primeira pontuação. VOLUME em gramas·repetição,
/// REPETICOES em repetições, TEMPO em segundos. Mudança de programa cria
/// versão nova (prospectiva): a anterior ganha `supersededAt`, nunca muda.
model ScoringReference {
  id           String               @id @default(cuid())
  tenantId     String
  studentId    String
  exerciseId   String
  kind         ScoringReferenceKind
  value        Int
  /// PRESCRICAO (programa), PRIMEIRA_EXECUCAO (sem carga prescrita ou
  /// treino avulso) ou PADRAO (aeróbico sem tempo prescrito: 30 min).
  source       String
  version      Int                  @default(1)
  createdAt    DateTime             @default(now())
  supersededAt DateTime?

  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([studentId, exerciseId, kind])
  @@map("scoring_references")
}

enum ScoringReferenceKind {
  VOLUME
  REPETICOES
  TEMPO
}

/// Pontuação de um treino concluído (uma por sessão; o diário pessoal é
/// único, os rankings só leem). Pontos em décimos. Sem foto, os pontos
/// ficam calculados mas fora do placar (PENDENTE_FOTO); a foto dentro do
/// prazo libera automaticamente. Excluir o treino leva a pontuação junto.
model SessionScore {
  id             String             @id @default(cuid())
  tenantId       String
  studentId      String
  sessionId      String             @unique
  ruleVersion    Int
  totalTenths    Int
  plannedItems   Int
  balancedTenths Int
  /// Detalhe por item: exercício, medida, feito, referência, pontos.
  items          Json
  status         SessionScoreStatus @default(PENDENTE_FOTO)
  /// Data da realização (`sessionPerformedAt`): períodos e rankings.
  performedAt    DateTime
  photoDeadline  DateTime
  releasedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  session  WorkoutSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)
  events   ScoreEvent[]
  contests ScoreContest[]

  @@unique([sessionId, tenantId])
  @@index([tenantId, studentId, performedAt])
  @@map("session_scores")
}

enum SessionScoreStatus {
  PENDENTE_FOTO
  LIBERADO
  CONTESTADO
  MANTIDO
  ANULADO
}

/// Trilha auditável de cada mudança de pontuação (crédito, liberação,
/// estorno, recálculo, decisão de contestação).
model ScoreEvent {
  id             String              @id @default(cuid())
  sessionScoreId String
  kind           String
  totalTenths    Int
  fromStatus     SessionScoreStatus?
  toStatus       SessionScoreStatus
  actorId        String?
  reason         String?
  createdAt      DateTime            @default(now())

  score SessionScore @relation(fields: [sessionScoreId], references: [id], onDelete: Cascade)

  @@index([sessionScoreId, createdAt])
  @@map("score_events")
}

/// Meta de pontos de um período (Desafios, ADR-019), congelada na primeira
/// leitura do período: 10 × dias previstos × exercícios por treino. A
/// medalha não é guardada: sai dos pontos oficiais contra esta meta, então
/// um estorno revisa a medalha sozinho.
model PeriodGoal {
  id              String    @id @default(cuid())
  tenantId        String
  studentId       String
  /// SEMANA ou MES.
  periodType      String
  /// "2026-10-05" (segunda) ou "2026-10".
  periodKey       String
  startsAt        DateTime
  endsAt          DateTime
  goalTenths      Int
  plannedDays     Int
  itemsPerWorkout Int
  /// Resultado congelado do período encerrado (feature 2, parte 2): pontos
  /// oficiais liberados até o fechamento. Editar ou excluir um treino
  /// depois não muda medalha já consolidada.
  finalTenths     Int?
  finalizedAt     DateTime?
  createdAt       DateTime  @default(now())

  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([studentId, periodType, periodKey])
  @@map("period_goals")
}

/// Ranking da turma do personal (Desafios, ADR-019). Ligado pelo personal;
/// `activatedAt` marca o início: treinos anteriores não entram. Desligar
/// guarda a data e não apaga nada.
model ClassRanking {
  tenantId      String    @id
  enabled       Boolean   @default(false)
  activatedAt   DateTime?
  deactivatedAt DateTime?
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("class_rankings")
}

/// Adesão voluntária do aluno ao ranking da turma. Conta só treino feito
/// depois de `joinedAt` (e da ativação). Sair grava `leftAt`; voltar
/// recomeça a contagem.
model ClassRankingParticipant {
  id        String    @id @default(cuid())
  tenantId  String
  studentId String    @unique
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  student Student @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId])
  @@map("class_ranking_participants")
}

/// Treino retroativo (feature 2, parte 2): trilha da versão anterior de um
/// treino editado ou excluído pelo próprio praticante. Sem chave para a
/// sessão, de propósito: a trilha sobrevive à exclusão.
model WorkoutSessionRevision {
  id                 String   @id @default(cuid())
  tenantId           String
  studentId          String
  sessionId          String
  actorUserId        String
  /// EDITADO ou EXCLUIDO.
  action             String
  /// Data, duração, exercícios e séries antes da mudança.
  snapshot           Json
  pointsTenthsBefore Int?
  pointsStatusBefore String?
  pointsTenthsAfter  Int?
  createdAt          DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("workout_session_revisions")
}

/// Desafios (feature 3, 4/4): grupo privado de amigos por convite, entre
/// quaisquer pessoas que treinam (alunos de personais diferentes e Livre).
/// Fora de tenant de propósito: o grupo cruza espaços; cada membro leva o
/// próprio escopo de treino (`tenantId` + `studentId`).
model FriendGroup {
  id          String   @id @default(cuid())
  name        String
  /// TOTAL (soma dos pontos) ou EQUILIBRADO (média por treino, 3 melhores por semana).
  mode        String
  inviteCode  String   @unique
  ownerUserId String
  createdAt   DateTime @default(now())

  owner   User                @relation("FriendGroupOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members FriendGroupMember[]
  seasons FriendSeason[]

  @@map("friend_groups")
}

/// Quem entrou no grupo, com o escopo de treino daquele momento. Sair grava
/// `leftAt`: para de contar e perde a leitura; o histórico mostra a saída.
model FriendGroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  tenantId  String
  studentId String
  /// ORGANIZADOR ou MEMBRO.
  role      String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  group   FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("friend_group_members")
}

/// Temporada do grupo: 7, 14 ou 28 dias. Uma de cada vez; conta só treino
/// feito dentro dela e depois da entrada de cada membro.
model FriendSeason {
  id         String   @id @default(cuid())
  groupId    String
  lengthDays Int
  startsAt   DateTime
  endsAt     DateTime
  createdAt  DateTime @default(now())

  group FriendGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, startsAt])
  @@map("friend_seasons")
}

/// Contestação de pontos (Desafios 4/4, parte B). Quem participa contesta
/// um treino de outra pessoa pelo resumo mínimo; o revisor (organizador do
/// grupo de amigos ou o personal da turma) mantém ou anula com
/// justificativa. Os pontos continuam valendo até a decisão. Uma contestação
/// aberta por treino; o autor pode recorrer uma vez de uma anulação.
model ScoreContest {
  id              String             @id @default(cuid())
  sessionScoreId  String
  /// Treino contestado (para a foto ficar visível ao revisor).
  sessionId       String
  /// AMIGOS ou TURMA.
  context         String
  friendGroupId   String?
  /// Espaço da turma (contexto TURMA).
  classTenantId   String?
  openedByUserId  String
  reviewerUserId  String
  reason          String
  /// ABERTA, MANTIDO ou ANULADO.
  status          String             @default("ABERTA")
  /// Situação dos pontos antes de abrir (volta a ela se nada mudar).
  previousStatus  SessionScoreStatus
  decision        String?
  decidedByUserId String?
  decidedAt       DateTime?
  /// Recurso do autor contra uma anulação.
  isAppeal        Boolean            @default(false)
  createdAt       DateTime           @default(now())

  score    SessionScore @relation(fields: [sessionScoreId], references: [id], onDelete: Cascade)
  openedBy User         @relation("ContestOpenedBy", fields: [openedByUserId], references: [id], onDelete: Cascade)
  reviewer User         @relation("ContestReviewer", fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([reviewerUserId, status])
  @@index([sessionScoreId])
  @@map("score_contests")
}

/// Funcional e CrossFit (feature 1, etapa 3): resultado de um bloco na
/// execução ao vivo. O timer do bloco guarda instantes e pausas (sobrevive
/// a recarregar a tela e a reconectar); o resultado é o que a pessoa
/// confirma, nunca a prescrição. Em For Time, "concluído" guarda o tempo
/// do bloco; "limite atingido" nunca vira tempo de conclusão.
model WorkoutBlockResult {
  id                 String    @id @default(cuid())
  tenantId           String
  sessionId          String
  blockKey           String
  startedAt          DateTime?
  pausedAt           DateTime?
  pausedSeconds      Int       @default(0)
  endedAt            DateTime?
  /// CONCLUIDO, LIMITE_ATINGIDO ou PARCIAL.
  outcome            String?
  roundsCompleted    Int?
  partialReps        Int?
  intervalsCompleted Int?
  /// Tempo do bloco (só For Time concluído, no modo ao vivo).
  elapsedSeconds     Int?
  note               String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session WorkoutSession @relation(fields: [sessionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([sessionId, blockKey])
  @@map("workout_block_results")
}

/// Cobranças SaaS do FitOS vindas do webhook do Asaas (feature 5, ADR-021):
/// o ledger que faltava para saber se a conta já pagou (segmento Novos) e
/// quais ciclos um cupom cobriu. Uma linha por cobrança (`externalPaymentId`),
/// atualizada a cada evento; nunca guarda dado do cartão nem do cliente.
model SaasPayment {
  id                     String    @id @default(cuid())
  tenantId               String
  externalPaymentId      String    @unique
  externalSubscriptionId String?
  valueCents             Int?
  dueDate                DateTime?
  /// Último estado conhecido: PENDENTE, PAGO, VENCIDO, ESTORNADO, REMOVIDO.
  status                 String
  paidAt                 DateTime?
  lastEvent              String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("saas_payments")
}

/// Cupons de desconto (feature 5, ADR-021). `Coupon` é a campanha (código
/// único e estado); as regras ficam em `CouponVersion`, imutável depois do
/// primeiro resgate (editar cria uma nova versão).
enum CouponStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum CouponKind {
  PERCENT
  FIXED_AMOUNT
}

model Coupon {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  status           CouponStatus @default(DRAFT)
  currentVersionId String?      @unique
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  currentVersion CouponVersion?     @relation("CouponCurrentVersion", fields: [currentVersionId], references: [id])
  versions       CouponVersion[]    @relation("CouponVersions")
  audit          CouponAudit[]
  redemptions    CouponRedemption[]

  @@map("coupons")
}

model CouponVersion {
  id              String         @id @default(cuid())
  couponId        String
  version         Int
  kind            CouponKind
  /// PERCENT: basis points (1% = 100). FIXED_AMOUNT: centavos.
  amount          Int
  products        TenantType[]
  /// NOVOS, ATIVOS, INATIVOS (OU) ou SELECIONADOS.
  segments        String[]
  planIds         String[]
  cycles          BillingCycle[]
  /// Janela de resgate (fim exclusivo); nulos = sem limite.
  startsAt        DateTime?
  endsAt          DateTime?
  durationCycles  Int
  maxRedemptions  Int?
  perAccountLimit Int            @default(1)
  budgetCents     Int?
  stackable       Boolean        @default(false)
  note            String?
  createdById     String
  createdAt       DateTime       @default(now())

  coupon      Coupon                 @relation("CouponVersions", fields: [couponId], references: [id], onDelete: Cascade)
  currentOf   Coupon?                @relation("CouponCurrentVersion")
  members     CouponAudienceMember[]
  redemptions CouponRedemption[]

  @@unique([couponId, version])
  @@map("coupon_versions")
}

/// Contas selecionadas de uma versão (segmento SELECIONADOS).
model CouponAudienceMember {
  id           String   @id @default(cuid())
  versionId    String
  tenantId     String
  selectedById String
  createdAt    DateTime @default(now())

  version CouponVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([versionId, tenantId])
  @@index([tenantId])
  @@map("coupon_audience_members")
}

/// Trilha das ações do administrador nas campanhas.
model CouponAudit {
  id         String   @id @default(cuid())
  couponId   String
  actorId    String
  operation  String
  before     Json?
  after      Json?
  occurredAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId, occurredAt])
  @@map("coupon_audit")
}

/// Resgate de um cupom por uma conta (feature 5, fatia 2). As condições
/// ficam congeladas aqui (tipo, valor, ciclos, plano, segmento); pausar,
/// encerrar ou editar a campanha não muda um resgate feito. O desconto é
/// aplicado cobrança a cobrança (fatia 3) até `cyclesUsed = durationCycles`.
enum CouponRedemptionState {
  COMMITTED
  ENDED
  CANCELED
}

model CouponRedemption {
  id                   String                @id @default(cuid())
  couponId             String
  versionId            String
  tenantId             String
  actorUserId          String
  state                CouponRedemptionState @default(COMMITTED)
  /// Chave do envio: repetir não resgata duas vezes.
  operationKey         String                @unique
  code                 String
  kind                 CouponKind
  amount               Int
  stackable            Boolean
  durationCycles       Int
  cyclesUsed           Int                   @default(0)
  segment              String
  planId               String
  baseCents            Int
  discountCents        Int
  /// Orçamento comprometido (ciclos × desconto no preço do resgate).
  committedBudgetCents Int
  /// Desconto efetivamente concedido (fatia 3).
  appliedCents         Int                   @default(0)
  committedAt          DateTime              @default(now())
  endedAt              DateTime?
  endReason            String?

  coupon  Coupon        @relation(fields: [couponId], references: [id], onDelete: Restrict)
  version CouponVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  tenant  Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, state])
  @@index([couponId, state])
  @@map("coupon_redemptions")
}
