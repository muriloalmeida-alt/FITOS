# FitOS — variáveis de ambiente locais (FIT-006/FIT-007/FIT-009/FIT-020)
#
# Nenhum valor real deve ser preenchido aqui. Este arquivo documenta apenas os
# nomes esperados. Cobrança continua fora do escopo.

# Nome público da aplicação, usado em título/metadata.
NEXT_PUBLIC_APP_NAME="FitOS"

# Ambiente lógico da aplicação: development | homologacao | production.
NEXT_PUBLIC_APP_ENV="development"

# String de conexão PostgreSQL usada pelo Prisma (FIT-007). Valor abaixo é
# apenas um exemplo de formato — nunca preencher com credencial real.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/fitos_dev"

# Segredo usado pelo Better Auth (FIT-009) para assinar cookies de sessão e
# tokens. Obrigatória — a aplicação falha ao iniciar sem ela. Gerar um valor
# aleatório longo por ambiente (ex.: `openssl rand -base64 32`); nunca reusar
# entre desenvolvimento, homologação e produção.
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-longo"

# URL pública/base da aplicação, usada pelo Better Auth para gerar links e
# cookies corretamente (FIT-009). Obrigatória.
BETTER_AUTH_URL="http://localhost:3000"

# Chave da Exercises API (API Ninjas), usada exclusivamente pelo client
# server-side em src/integrations/api-ninjas (FIT-020) — nunca prefixar com
# NEXT_PUBLIC_, nunca expor no navegador. Opcional: sem esta variável, a
# aplicação continua funcionando normalmente (catálogo próprio e catálogo
# global já importado seguem disponíveis); apenas a importação/consulta real
# à API Ninjas permanece indisponível. Qualquer chave já mencionada em
# conversa é considerada exposta — nunca reutilizá-la; usar somente uma chave
# nova, obtida por canal seguro. Ver ADR-004.
API_NINJAS_API_KEY=""

# Segredo da rota HTTP interna de disparo da carga do catálogo
# (src/app/api/admin/catalog-import, IMP-EX-001) — EXCEÇÃO DE GOVERNANÇA:
# o pacote pós-MVP proíbe endpoint público para isso; esta rota existe só
# porque o acesso SSH/CLI ao Railway não funcionou para o Product Owner em
# 21/09/2026 (ver docs/06-engenharia/arquitetura/INTEGRACAO-API-NINJAS.md).
# Opcional: sem esta variável, a rota se comporta como se não existisse
# (404 em qualquer requisição, em qualquer método). Gerar um valor aleatório
# longo (ex.: `openssl rand -hex 32`), nunca reaproveitar de outro
# propósito (nunca igual a BETTER_AUTH_SECRET/API_NINJAS_API_KEY), nunca
# commitar um valor real, remover/desconfigurar a variável assim que a
# carga real for concluída e confirmada.
# ATENÇÃO — exceção adicional (21/09/2026): a rota também aceita este
# segredo por ?secret= na query string (para uma ferramenta sem controle
# de header). Um valor usado por URL fica gravado em log de acesso —
# tratar como exposto a partir do primeiro uso e rotacionar (gerar valor
# novo, reconfigurar no Railway) assim que a carga real terminar.
CATALOG_IMPORT_TRIGGER_SECRET=""

# Cloudflare R2 (storage compatível com S3) das ilustrações do catálogo de
# exercícios — ver docs/06-engenharia/arquitetura/
# ARMAZENAMENTO-DE-MIDIA-EXERCICIOS.md e ADR-010. Usadas exclusivamente por
# `scripts/import-imagens-exercicios.ts` (execução manual, nunca em
# build/seed/deploy) através de src/modules/exercises/r2Config.ts —
# server-only, nunca lidas por código que roda no navegador. Todas
# obrigatórias para a carga real; sem elas, só `--dry-run` funciona (ele
# avisa quais estão ausentes, sem bloquear a validação local). Valores
# abaixo são só exemplos de formato — nunca preencher com credencial real
# aqui; em Railway/homologação/produção, configurar direto no serviço.

# ID da conta Cloudflare (compõe o endpoint R2).
R2_ACCOUNT_ID="0000000000000000000000000000000a"

# Credenciais de uma API Token do R2 com permissão restrita ao bucket usado
# por este projeto — nunca a chave-mestra da conta Cloudflare.
R2_ACCESS_KEY_ID="troque-por-uma-access-key-do-r2"
R2_SECRET_ACCESS_KEY="troque-por-um-segredo-longo-do-r2"

# Nome do bucket dedicado às ilustrações do catálogo.
R2_BUCKET_NAME="fitos-exercicios"

# Endpoint S3-compatível do R2 para esta conta (formato do Cloudflare).
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Base pública (domínio customizado ou r2.dev) usada para montar a URL final
# de cada imagem — nunca com barra final (o código normaliza, mas evite
# configurar já com barra).
R2_PUBLIC_BASE_URL="https://media.fitos.example.com"

# Região S3 a informar ao SDK. Opcional — sem esta variável, o código usa
# "auto" (valor recomendado pela Cloudflare para R2).
R2_REGION="auto"
