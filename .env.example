# FitOS — variáveis de ambiente locais (FIT-006/FIT-007/FIT-009/FIT-020)
#
# Nenhum valor real deve ser preenchido aqui. Este arquivo documenta apenas os
# nomes esperados. Cobrança continua fora do escopo.

# Nome público da aplicação, usado em título/metadata.
NEXT_PUBLIC_APP_NAME="FitOS"

# Ambiente lógico da aplicação: development | homologacao | production.
NEXT_PUBLIC_APP_ENV="development"

# Chave da API do Asaas (FIT-128, Issue #153). Lida por
# src/modules/billing/asaasClient.ts e usada em modo de melhor esforço por
# subscribeTenantToPlan/cancelSubscription para criar/atualizar/cancelar
# cliente e assinatura reais no Asaas — confirmado funcionando em
# homologação em 28/09/2026 (ver ASSINATURA-SAAS.md). Nunca a chave de
# produção do Asaas nesta variável em nenhum ambiente que não seja a
# própria produção.
API_ASAAS="troque-pela-chave-sandbox-do-asaas"

# Token de autenticação do webhook do Asaas (FIT-128, ADR-010 item (c)).
# Valor escolhido por quem configura o webhook no próprio painel do Asaas
# (Configurações > Integrações > Webhooks) — nunca a mesma chave de
# API_ASAAS. src/app/api/webhooks/asaas/route.ts compara este valor (tempo
# constante, secretsMatch) contra o header `asaas-access-token` de cada
# entrega, e recusa (401) qualquer requisição sem o token correto. Sem esta
# variável configurada, a rota recusa toda entrega com 503 — nunca processa
# um evento sem poder autenticar a origem. Gerar um valor aleatório longo
# por ambiente, nunca reusar entre homologação e produção.
API_ASAAS_WEBHOOK_TOKEN="troque-por-um-segredo-aleatorio-longo"

# String de conexão PostgreSQL usada pelo Prisma (FIT-007). Valor abaixo é
# apenas um exemplo de formato — nunca preencher com credencial real.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/fitos_dev"

# Segredo usado pelo Better Auth (FIT-009) para assinar cookies de sessão e
# tokens. Obrigatória — a aplicação falha ao iniciar sem ela. Gerar um valor
# aleatório longo por ambiente (ex.: `openssl rand -base64 32`); nunca reusar
# entre desenvolvimento, homologação e produção.
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-longo"

# URL pública/base da aplicação, usada pelo Better Auth para gerar links e
# cookies corretamente (FIT-009). Obrigatória.
BETTER_AUTH_URL="http://localhost:3000"

# A integração com a Exercises API (API Ninjas, FIT-020) e a rota HTTP
# interna de disparo de carga (src/app/api/admin/catalog-import, IMP-EX-001)
# foram descontinuadas pela FIT-121 — nenhuma das duas chegou a ter uma
# carga real executada em nenhum ambiente (ver
# docs/06-engenharia/arquitetura/INTEGRACAO-API-NINJAS.md). As variáveis
# API_NINJAS_API_KEY e CATALOG_IMPORT_TRIGGER_SECRET, que existiam só para
# esse código agora removido, foram removidas deste arquivo junto com ele.

# Cloudflare R2 (storage compatível com S3) das ilustrações do catálogo de
# exercícios — ver docs/06-engenharia/arquitetura/
# ARMAZENAMENTO-DE-MIDIA-EXERCICIOS.md e ADR-011. Usadas exclusivamente por
# `scripts/import-imagens-exercicios.ts` (execução manual, nunca em
# build/seed/deploy) através de src/modules/exercises/r2Config.ts —
# server-only, nunca lidas por código que roda no navegador. Todas
# obrigatórias para a carga real; sem elas, só `--dry-run` funciona (ele
# avisa quais estão ausentes, sem bloquear a validação local). Valores
# abaixo são só exemplos de formato — nunca preencher com credencial real
# aqui; em Railway/homologação/produção, configurar direto no serviço.

# ID da conta Cloudflare (compõe o endpoint R2).
R2_ACCOUNT_ID="0000000000000000000000000000000a"

# Credenciais de uma API Token do R2 com permissão restrita ao bucket usado
# por este projeto — nunca a chave-mestra da conta Cloudflare.
R2_ACCESS_KEY_ID="troque-por-uma-access-key-do-r2"
R2_SECRET_ACCESS_KEY="troque-por-um-segredo-longo-do-r2"

# Nome do bucket dedicado às ilustrações do catálogo.
R2_BUCKET_NAME="fitos-exercicios"

# Endpoint S3-compatível do R2 para esta conta (formato do Cloudflare).
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Base pública (domínio customizado ou r2.dev) usada para montar a URL final
# de cada imagem — nunca com barra final (o código normaliza, mas evite
# configurar já com barra).
R2_PUBLIC_BASE_URL="https://media.fitos.example.com"

# Região S3 a informar ao SDK. Opcional — sem esta variável, o código usa
# "auto" (valor recomendado pela Cloudflare para R2).
R2_REGION="auto"

# Conta de administrador da plataforma (tela /painel/admin: trocar senha e
# excluir usuários). Criada no deploy por `npm run admin:garantir` se ainda
# não existir; a senha só é sobrescrita com ADMIN_RESET_PASSWORD=true. Use um e-mail que não
# seja de nenhuma outra conta. Deixe vazio para não criar.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrador"
# Com "true", o próximo deploy troca a senha do admin pela de ADMIN_PASSWORD
# (e encerra as sessões dele). Remova depois de usar.
ADMIN_RESET_PASSWORD=""

# Notificações push (EPIC-31, Web Push). Gere o par com `npm run push:chaves`
# e copie as duas chaves para o Railway. Sem elas, nenhuma notificação é
# enviada e as telas avisam que o recurso está indisponível.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contato do remetente exigido pelo protocolo (mailto: ou https:).
VAPID_SUBJECT="mailto:contato@fitos.app"
# "off" desliga o agendador dos lembretes de treino.
PUSH_LEMBRETES=""
