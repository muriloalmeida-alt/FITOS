# FitOS — variáveis de ambiente locais (FIT-006/FIT-007/FIT-009/FIT-020)
#
# Nenhum valor real deve ser preenchido aqui. Este arquivo documenta apenas os
# nomes esperados. Cobrança continua fora do escopo.

# Nome público da aplicação, usado em título/metadata.
NEXT_PUBLIC_APP_NAME="FitOS"

# Ambiente lógico da aplicação: development | homologacao | production.
NEXT_PUBLIC_APP_ENV="development"

# String de conexão PostgreSQL usada pelo Prisma (FIT-007). Valor abaixo é
# apenas um exemplo de formato — nunca preencher com credencial real.
DATABASE_URL="postgresql://usuario:senha@localhost:5432/fitos_dev"

# Segredo usado pelo Better Auth (FIT-009) para assinar cookies de sessão e
# tokens. Obrigatória — a aplicação falha ao iniciar sem ela. Gerar um valor
# aleatório longo por ambiente (ex.: `openssl rand -base64 32`); nunca reusar
# entre desenvolvimento, homologação e produção.
BETTER_AUTH_SECRET="troque-por-um-segredo-aleatorio-longo"

# URL pública/base da aplicação, usada pelo Better Auth para gerar links e
# cookies corretamente (FIT-009). Obrigatória.
BETTER_AUTH_URL="http://localhost:3000"

# Chave da Exercises API (API Ninjas), usada exclusivamente pelo client
# server-side em src/integrations/api-ninjas (FIT-020) — nunca prefixar com
# NEXT_PUBLIC_, nunca expor no navegador. Opcional: sem esta variável, a
# aplicação continua funcionando normalmente (catálogo próprio e catálogo
# global já importado seguem disponíveis); apenas a importação/consulta real
# à API Ninjas permanece indisponível. Qualquer chave já mencionada em
# conversa é considerada exposta — nunca reutilizá-la; usar somente uma chave
# nova, obtida por canal seguro. Ver ADR-004.
API_NINJAS_API_KEY=""
